{% canopy config %}
{
    "title": "Call to Action",
    "name": "cta",
    "settings": [
        {
            "name": "layout",
            "type": "radio",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "centered", "label": "Centred — heading and buttons" },
                { "value": "banner", "label": "Banner — text left, button right" },
                { "value": "image", "label": "Image background" },
                { "value": "boxed", "label": "Boxed — inset card" }
            ],
            "default": "centered"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Hear it first", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "p", "label": "No heading (plain text)" }] },
        { "name": "subheading", "type": "textarea", "label": "Sub heading", "tab": "Content", "default": "New dates, new music, presale codes. No spam, ever." },
        { "name": "primary_cta", "type": "url", "label": "Primary button", "tab": "Content", "default": { "url": "#signup", "text": "Sign up", "target": "_self" } },
        { "name": "secondary_cta", "type": "url", "label": "Secondary button", "tab": "Content", "default": { "url": "", "text": "", "target": "_self" } },
        { "name": "image", "type": "file", "label": "Background image", "accept": "image/*", "tab": "Content" },
        {
            "name": "overlay",
            "type": "select",
            "label": "Image overlay",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "light", "label": "Light" },
                { "value": "medium", "label": "Medium" },
                { "value": "heavy", "label": "Heavy" }
            ],
            "default": "medium"
        },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "accent", "label": "Accent" },
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "accent"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#7c5cff" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#ffffff" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        {
            "name": "size",
            "type": "select",
            "label": "Heading size",
            "tab": "Style",
            "options": [
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}
{% set overlays = { 'none': '', 'light': 'bg-black/30', 'medium': 'bg-black/50', 'heavy': 'bg-black/70' } %}
{% set sizes = { 'md': 'text-3xl sm:text-4xl', 'lg': 'text-4xl sm:text-5xl', 'xl': 'text-5xl sm:text-6xl lg:text-7xl' } %}

{% set has_image = settings.layout == 'image' and settings.image.path is not empty %}
{% set tone_class = has_image ? 'text-white' : (settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['accent'])) %}
{% set tone_style = (settings.tone == 'custom' and not has_image) ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set size_class = sizes[settings.size] ?? sizes['lg'] %}
{% set el = settings.heading.element ?? 'h2' %}

{% set inner %}
  <div class="{{ settings.layout == 'banner' ? 'flex flex-col gap-6 md:flex-row md:items-center md:justify-between' : 'mx-auto max-w-3xl text-center' }}">
    <div class="{{ settings.layout == 'banner' ? 'max-w-2xl' : '' }}">
      {% if settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}
      <{{ el }} class="mt-2 text-balance {{ size_class }}">{{ settings.heading.value }}</{{ el }}>
      {% if settings.subheading %}
        <p class="mt-4 text-lg leading-relaxed opacity-80">{{ settings.subheading }}</p>
      {% endif %}
    </div>

    {% if settings.primary_cta.url or settings.secondary_cta.url %}
      <div class="flex flex-wrap gap-3 {{ settings.layout == 'banner' ? 'shrink-0' : 'mt-8 justify-center' }}">
        {% if settings.primary_cta.url %}
          <a
            href="{{ settings.primary_cta.url }}"
            target="{{ settings.primary_cta.target }}"
            class="btn {{ settings.tone == 'accent' and not has_image ? 'btn-outline' : 'btn-primary' }}"
          >{{ settings.primary_cta.text }}</a>
        {% endif %}
        {% if settings.secondary_cta.url %}
          <a href="{{ settings.secondary_cta.url }}" target="{{ settings.secondary_cta.target }}" class="btn btn-outline">{{ settings.secondary_cta.text }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endset %}

{% if settings.layout == 'boxed' %}
  <section {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %} class="bg-bg">
    <div class="wrap {{ pad_class }}">
      <div
        class="rounded-theme px-6 py-14 sm:px-12 sm:py-20 {{ tone_class }}"
        {% if tone_style %}style="{{ tone_style }}"{% endif %}
      >
        {{ inner|raw }}
      </div>
    </div>
  </section>

{% else %}
  <section
    {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
    class="relative isolate overflow-hidden {{ tone_class }}"
    {% if tone_style %}style="{{ tone_style }}"{% endif %}
  >
    {% if has_image %}
      <img src="{{ settings.image.path }}" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      {% if overlays[settings.overlay] %}
        <div class="absolute inset-0 -z-10 {{ overlays[settings.overlay] }}" aria-hidden="true"></div>
      {% endif %}
    {% endif %}

    <div class="wrap {{ pad_class }}">
      {{ inner|raw }}
    </div>
  </section>
{% endif %}
{% endcanopy %}

