{% canopy config %}
{
    "title": "Tickets",
    "name": "tickets",
    "settings": [
        {
            "name": "layout",
            "type": "select",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "spotlight", "label": "Spotlight — the next show, large" },
                { "value": "banner", "label": "Banner — a single strip across the page" },
                { "value": "panel", "label": "Panel — boxed, with the details listed" },
                { "value": "outlets", "label": "Outlets — where to buy, side by side" }
            ],
            "default": "spotlight"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "On sale now" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Get tickets", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "intro", "type": "textarea", "label": "Intro", "tab": "Content", "default": "" },
        { "name": "show_header", "type": "checkbox", "label": "Show the heading", "tab": "Content", "default": true },
        { "name": "cta", "type": "url", "label": "Main ticket button", "tab": "Content", "default": { "url": "", "text": "Buy tickets", "target": "_blank" } },
        { "name": "cta_secondary", "type": "url", "label": "Second button", "tab": "Content", "default": { "url": "", "text": "VIP and packages", "target": "_blank" } },
        { "name": "empty_text", "type": "text", "label": "Text shown when there's nothing on sale", "tab": "Content", "default": "Nothing on sale right now — sign up to hear first." },
        {
            "name": "source",
            "type": "radio",
            "label": "Where the show details come from",
            "tab": "Show",
            "options": [
                { "value": "collection", "label": "The next date in a collection" },
                { "value": "manual", "label": "Typed into this block" }
            ],
            "default": "collection"
        },
        {
            "name": "collection_handle",
            "type": "select",
            "label": "Collection",
            "tab": "Show",
            "group": "From a collection",
            "options": [
                { "value": "tour_dates", "label": "Tour Dates" }
            ],
            "default": "tour_dates"
        },
        { "name": "featured_only", "type": "checkbox", "label": "Only consider featured shows", "tab": "Show", "group": "From a collection", "default": false },
        { "name": "date_format", "type": "text", "label": "Date format", "tab": "Show", "group": "From a collection", "default": "l j F Y" },
        { "name": "use_collection_link", "type": "checkbox", "label": "Use the show's own ticket link for the button", "tab": "Show", "group": "From a collection", "default": true },
        { "name": "manual_date", "type": "text", "label": "Date", "tab": "Show", "group": "Typed into this block", "default": "" },
        { "name": "manual_city", "type": "text", "label": "City", "tab": "Show", "group": "Typed into this block", "default": "" },
        { "name": "manual_venue", "type": "text", "label": "Venue", "tab": "Show", "group": "Typed into this block", "default": "" },
        { "name": "manual_status", "type": "text", "label": "Badge", "tab": "Show", "group": "Typed into this block", "default": "", "help_text": "Low tickets, Sold out, Presale…" },
        { "name": "image", "type": "file", "label": "Background or side image", "accept": "image/*", "tab": "Show" },
        {
            "name": "notes",
            "type": "list",
            "label": "Details — one per item, e.g. Doors 7pm",
            "tab": "Details",
            "default": [
                "Doors 7pm",
                "14+ — under 16s with an adult",
                "Presale Wednesday 10am"
            ]
        },
        {
            "name": "outlets",
            "type": "list",
            "label": "Ticket outlets — one per item, separated by | : Name | Link | Note",
            "tab": "Details",
            "default": [
                "Official box office | https://example.com/tickets | No booking fee",
                "Ticketmaster | https://example.com/tickets |",
                "Resale — face value only | https://example.com/tickets |"
            ]
        },
        { "name": "show_date", "type": "checkbox", "label": "Show the date", "tab": "Visibility", "default": true },
        { "name": "show_venue", "type": "checkbox", "label": "Show the venue", "tab": "Visibility", "default": true },
        { "name": "show_badge", "type": "checkbox", "label": "Show the availability badge", "tab": "Visibility", "default": true },
        { "name": "show_notes", "type": "checkbox", "label": "Show the details list", "tab": "Visibility", "default": true },
        { "name": "show_outlets", "type": "checkbox", "label": "Show the ticket outlets", "tab": "Visibility", "default": false },
        { "name": "show_image", "type": "checkbox", "label": "Show the image", "tab": "Visibility", "default": true },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "accent", "label": "Accent" },
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "accent"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "button_style",
            "type": "select",
            "label": "Main button",
            "tab": "Style",
            "options": [
                { "value": "primary", "label": "Accent" },
                { "value": "accent-2", "label": "Second accent" },
                { "value": "outline", "label": "Outline" }
            ],
            "default": "primary"
        },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "md"
        },
        {
            "name": "align",
            "type": "radio",
            "label": "Alignment",
            "tab": "Style",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Centre" }
            ],
            "default": "left"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "tickets" }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  A single show pushed hard — the next date out of the `tour_dates`
  Collection, or details typed straight into the block.

  The block still renders with no show attached: the outlets layout and a
  manually written button work on their own, which is what a "tickets" page
  needs between tours.

  Guard the lookup with `?? []` — an unknown handle returns null, and piping
  null into |filter throws, which Canopy swallows into a blank section.
#}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}
{% set buttons = { 'primary': 'btn-primary', 'accent-2': 'btn-accent-2', 'outline': 'btn-outline' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['accent']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['md'] %}
{% set btn_class = buttons[settings.button_style] ?? buttons['primary'] %}
{% set align_class = settings.align == 'center' ? 'text-center mx-auto max-w-2xl' : '' %}
{% set el = settings.heading.element ?? 'h2' %}
{% set layout = settings.layout ?? 'spotlight' %}

{# ---- The show: date, city, venue, badge, link ---- #}
{% set show = { 'date': '', 'city': '', 'venue': '', 'badge': '', 'link': '' } %}

{% if settings.source == 'collection' %}
  {% set entries = cms.collection(settings.collection_handle ?? 'tour_dates') ?? [] %}
  {% set entries = entries|filter(e => e.date is not empty and (e.date|date('U')) >= ('now'|date('U'))) %}
  {% if settings.featured_only %}
    {% set entries = entries|filter(e => e.featured == 'Yes') %}
  {% endif %}
  {% set entries = entries|sort((a, b) => (a.date|date('U')) <=> (b.date|date('U'))) %}
  {% set next = entries|first %}

  {% if next %}
    {% set show = {
        'date': next.date_label ?: next.date|date(settings.date_format ?? 'l j F Y'),
        'city': next.city ?? '',
        'venue': next.venue ?? '',
        'badge': (next.status and next.status != 'On sale') ? next.status : '',
        'link': next.ticket_url ?? ''
    } %}
  {% endif %}
{% else %}
  {% set show = {
      'date': settings.manual_date,
      'city': settings.manual_city,
      'venue': settings.manual_venue,
      'badge': settings.manual_status,
      'link': ''
  } %}
{% endif %}

{# The block's own button wins unless it's empty and the show carries a link. #}
{% set cta_url = settings.cta.url ?: ((settings.source == 'collection' and settings.use_collection_link) ? show.link : '') %}
{% set has_show = (show.date ~ show.city ~ show.venue)|trim is not empty %}

{% set outlets = [] %}
{% for row in settings.outlets|filter(o => o|trim is not empty) %}
  {% set p = row|split('|') %}
  {% set outlets = outlets|merge([{
      'name': (p[0] ?? '')|trim,
      'url': (p[1] ?? '')|trim,
      'note': (p[2] ?? '')|trim
  }]) %}
{% endfor %}

{% set notes = settings.notes|filter(n => n|trim is not empty) %}

{% import _self as ui %}

{% macro badge(text) %}
  <span class="inline-block rounded-theme border border-current px-3 py-1.5 text-xs font-semibold tracking-wide uppercase opacity-70">{{ text }}</span>
{% endmacro %}

{% macro buttons(settings, cta_url, btn_class) %}
  <div class="flex flex-wrap items-center gap-3">
    {% if cta_url %}
      <a href="{{ cta_url }}" target="{{ settings.cta.target ?? '_blank' }}" rel="noopener" class="btn {{ btn_class }}">{{ settings.cta.text ?: 'Buy tickets' }}</a>
    {% endif %}
    {% if settings.cta_secondary.url %}
      <a href="{{ settings.cta_secondary.url }}" target="{{ settings.cta_secondary.target }}" rel="noopener" class="btn btn-outline">{{ settings.cta_secondary.text }}</a>
    {% endif %}
  </div>
{% endmacro %}

{% macro notes_list(notes, klass) %}
  <ul class="{{ klass }} list-none">
    {% for note in notes %}
      <li class="flex items-baseline gap-2 py-1 text-sm opacity-70">
        <span aria-hidden="true" class="text-xs">&bull;</span>{{ note }}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{% macro outlet_list(outlets, klass) %}
  <div class="{{ klass }} grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for outlet in outlets %}
      <a
        href="{{ outlet.url }}"
        target="_blank"
        rel="noopener"
        class="flex flex-col rounded-theme border border-current/25 px-5 py-4 no-underline transition hover:border-current/60"
      >
        <span class="font-heading text-lg leading-tight">{{ outlet.name }}</span>
        {% if outlet.note %}<span class="mt-1 text-xs opacity-60">{{ outlet.note }}</span>{% endif %}
      </a>
    {% endfor %}
  </div>
{% endmacro %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    {# ---------------- Banner — one strip ---------------- #}
    {% if layout == 'banner' %}
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          {% if settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}
          {% if has_show %}
            <p class="font-heading mt-2 text-2xl leading-tight sm:text-3xl">
              {% if settings.show_date and show.date %}{{ show.date }} — {% endif %}{{ show.city }}
            </p>
            {% if settings.show_venue and show.venue %}<p class="mt-1 text-sm opacity-70">{{ show.venue }}</p>{% endif %}
          {% else %}
            <{{ el }} class="mt-2 text-2xl sm:text-3xl">{{ settings.heading.value }}</{{ el }}>
          {% endif %}
        </div>
        <div class="flex flex-wrap items-center gap-4">
          {% if settings.show_badge and show.badge %}{{ ui.badge(show.badge) }}{% endif %}
          {{ ui.buttons(settings, cta_url, btn_class) }}
        </div>
      </div>

    {# ---------------- Outlets — where to buy ---------------- #}
    {% elseif layout == 'outlets' %}
      <div class="{{ align_class }}">
        {% if settings.show_header %}
          {% if settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}
          <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          {% if settings.intro %}<p class="mt-4 text-lg opacity-70">{{ settings.intro }}</p>{% endif %}
        {% endif %}
      </div>
      {% if outlets|length %}
        {{ ui.outlet_list(outlets, 'mt-10') }}
      {% else %}
        <p class="mt-8 text-lg opacity-60">{{ settings.empty_text }}</p>
      {% endif %}
      {% if settings.show_notes and notes|length %}{{ ui.notes_list(notes, 'mt-8') }}{% endif %}

    {# ---------------- Panel — boxed details ---------------- #}
    {% elseif layout == 'panel' %}
      <div class="mx-auto max-w-2xl rounded-theme border border-current/20 p-8 sm:p-10">
        {% if settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}
        {% if settings.show_header %}
          <{{ el }} class="mt-3 text-3xl text-balance sm:text-4xl">{{ settings.heading.value }}</{{ el }}>
        {% endif %}
        {% if settings.intro %}<p class="mt-3 opacity-70">{{ settings.intro }}</p>{% endif %}

        {% if has_show %}
          <dl class="mt-6 grid gap-4 sm:grid-cols-3">
            {% if settings.show_date and show.date %}
              <div>
                <dt class="text-xs tracking-[0.14em] uppercase opacity-50">Date</dt>
                <dd class="font-heading mt-1 text-lg leading-tight">{{ show.date }}</dd>
              </div>
            {% endif %}
            {% if show.city %}
              <div>
                <dt class="text-xs tracking-[0.14em] uppercase opacity-50">City</dt>
                <dd class="font-heading mt-1 text-lg leading-tight">{{ show.city }}</dd>
              </div>
            {% endif %}
            {% if settings.show_venue and show.venue %}
              <div>
                <dt class="text-xs tracking-[0.14em] uppercase opacity-50">Venue</dt>
                <dd class="font-heading mt-1 text-lg leading-tight">{{ show.venue }}</dd>
              </div>
            {% endif %}
          </dl>
        {% endif %}

        {% if settings.show_notes and notes|length %}{{ ui.notes_list(notes, 'mt-6') }}{% endif %}

        <div class="mt-8 flex flex-wrap items-center gap-4">
          {{ ui.buttons(settings, cta_url, btn_class) }}
          {% if settings.show_badge and show.badge %}{{ ui.badge(show.badge) }}{% endif %}
        </div>

        {% if settings.show_outlets and outlets|length %}{{ ui.outlet_list(outlets, 'mt-8') }}{% endif %}
      </div>

    {# ---------------- Spotlight ---------------- #}
    {% else %}
      <div class="grid items-center gap-10 {{ settings.show_image and settings.image.path ? 'lg:grid-cols-2 lg:gap-16' : '' }}">
        <div class="{{ settings.show_image and settings.image.path ? '' : align_class }}">
          {% if settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}

          {% if has_show %}
            {% if settings.show_date and show.date %}
              <p class="mt-3 text-sm font-semibold tracking-[0.16em] uppercase opacity-70">{{ show.date }}</p>
            {% endif %}
            <p class="font-heading mt-2 text-4xl leading-tight text-balance sm:text-6xl">{{ show.city }}</p>
            {% if settings.show_venue and show.venue %}
              <p class="mt-2 text-lg opacity-70">{{ show.venue }}</p>
            {% endif %}
          {% else %}
            {% if settings.show_header %}
              <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
            {% endif %}
          {% endif %}

          {% if settings.intro %}<p class="mt-4 text-lg opacity-70">{{ settings.intro }}</p>{% endif %}
          {% if settings.show_notes and notes|length %}{{ ui.notes_list(notes, 'mt-6') }}{% endif %}

          {% if cta_url or settings.cta_secondary.url %}
            <div class="mt-8 flex flex-wrap items-center gap-4 {{ settings.align == 'center' and not (settings.show_image and settings.image.path) ? 'justify-center' : '' }}">
              {{ ui.buttons(settings, cta_url, btn_class) }}
              {% if settings.show_badge and show.badge %}{{ ui.badge(show.badge) }}{% endif %}
            </div>
          {% elseif not has_show %}
            <p class="mt-6 text-lg opacity-60">{{ settings.empty_text }}</p>
          {% endif %}

          {% if settings.show_outlets and outlets|length %}{{ ui.outlet_list(outlets, 'mt-10') }}{% endif %}
        </div>

        {% if settings.show_image and settings.image.path %}
          <img
            src="{{ settings.image.path }}"
            alt=""
            loading="lazy"
            class="aspect-4/5 w-full rounded-theme object-cover lg:aspect-square"
          />
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% endcanopy %}

