{% canopy config %}
{
    "title": "Hero",
    "name": "hero",
    "settings": [
        {
            "name": "layout",
            "type": "select",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "spotlight", "label": "Spotlight — full-bleed media, centred text" },
                { "value": "poster", "label": "Poster — huge type, text bottom left" },
                { "value": "stack", "label": "Stack — centred lines of type, button row" },
                { "value": "card", "label": "Card — full-bleed media, floating panel" },
                { "value": "corner", "label": "Corner — full-bleed media, text in one corner" },
                { "value": "split", "label": "Split — text one side, image the other" },
                { "value": "minimal", "label": "Minimal — type only, no media" }
            ],
            "default": "spotlight"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "New album — out now" },
        {
            "name": "heading_type",
            "type": "radio",
            "label": "Heading",
            "tab": "Content",
            "group": "Heading",
            "options": [
                { "value": "text", "label": "Text" },
                { "value": "image", "label": "Artwork — upload a logo or title treatment" },
                { "value": "brand", "label": "Artwork — from the Brand collection" }
            ],
            "default": "text"
        },
        { "name": "heading", "type": "heading", "label": "Heading text", "tab": "Content", "group": "Heading", "default": { "value": "Midnight Frequencies", "element": "h1" }, "elements": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "p", "label": "No heading (plain text)" }] },
        { "name": "heading_image", "type": "file", "label": "Heading artwork", "accept": "image/*", "tab": "Content", "group": "Heading", "help_text": "Replaces the heading text. The heading text is still used as the alt text." },
        { "name": "heading_image_width", "type": "number", "label": "Artwork width (px)", "tab": "Content", "group": "Heading", "min": 120, "max": 1200, "default": 480 },
        {
            "name": "heading_variant",
            "type": "select",
            "label": "Which Brand version",
            "tab": "Content",
            "group": "Heading",
            "options": [
                { "value": "wordmark", "label": "Wordmark" },
                { "value": "primary", "label": "Primary logo" },
                { "value": "light", "label": "Light — for dark backgrounds" },
                { "value": "dark", "label": "Dark — for light backgrounds" },
                { "value": "symbol", "label": "Symbol / icon" }
            ],
            "default": "wordmark"
        },
        { "name": "kicker", "type": "text", "label": "Line under the heading", "tab": "Content", "default": "Live in Mexico City" },
        { "name": "subheading", "type": "textarea", "label": "Sub heading", "tab": "Content", "default": "Ten new tracks recorded live over one long winter. Stream it everywhere, or catch it in a room near you." },
        { "name": "primary_cta", "type": "url", "label": "Primary button", "tab": "Content", "default": { "url": "#listen", "text": "Listen now", "target": "_self" } },
        { "name": "secondary_cta", "type": "url", "label": "Secondary button", "tab": "Content", "default": { "url": "#tour", "text": "Tour dates", "target": "_self" } },
        { "name": "third_cta", "type": "url", "label": "Third button", "tab": "Content", "default": { "url": "", "text": "Pre-order", "target": "_self" } },
        { "name": "image", "type": "file", "label": "Background / feature image", "accept": "image/*", "tab": "Media" },
        { "name": "image_alt", "type": "text", "label": "Image description", "tab": "Media", "default": "" },
        { "name": "video", "type": "file", "label": "Background video (used instead of the image)", "accept": "video/*", "tab": "Media" },
        { "name": "show_eyebrow", "type": "checkbox", "label": "Show the eyebrow", "tab": "Visibility", "default": true },
        { "name": "show_heading", "type": "checkbox", "label": "Show the heading", "tab": "Visibility", "default": true },
        { "name": "show_kicker", "type": "checkbox", "label": "Show the line under the heading", "tab": "Visibility", "default": false },
        { "name": "show_subheading", "type": "checkbox", "label": "Show the sub heading", "tab": "Visibility", "default": true },
        { "name": "show_buttons", "type": "checkbox", "label": "Show the buttons", "tab": "Visibility", "default": true },
        { "name": "show_media", "type": "checkbox", "label": "Show the image / video", "tab": "Visibility", "default": true },
        { "name": "show_scroll_hint", "type": "checkbox", "label": "Show the scroll indicator", "tab": "Visibility", "default": false },
        {
            "name": "height",
            "type": "select",
            "label": "Height",
            "tab": "Style",
            "options": [
                { "value": "auto", "label": "Fit content" },
                { "value": "medium", "label": "Medium (60% of screen)" },
                { "value": "large", "label": "Large (80% of screen)" },
                { "value": "full", "label": "Full screen" }
            ],
            "default": "large"
        },
        {
            "name": "overlay",
            "type": "select",
            "label": "Media overlay",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "light", "label": "Light" },
                { "value": "medium", "label": "Medium" },
                { "value": "heavy", "label": "Heavy" },
                { "value": "gradient", "label": "Gradient from bottom" },
                { "value": "gradient-left", "label": "Gradient from the left" }
            ],
            "default": "gradient"
        },
        {
            "name": "align",
            "type": "radio",
            "label": "Text alignment",
            "tab": "Style",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Centre" }
            ],
            "default": "center"
        },
        {
            "name": "corner",
            "type": "select",
            "label": "Corner / Card layout: which corner",
            "tab": "Style",
            "options": [
                { "value": "bottom-left", "label": "Bottom left" },
                { "value": "bottom-right", "label": "Bottom right" },
                { "value": "top-left", "label": "Top left" },
                { "value": "center-left", "label": "Middle left" }
            ],
            "default": "bottom-left"
        },
        {
            "name": "size",
            "type": "select",
            "label": "Heading size",
            "tab": "Style",
            "options": [
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" },
                { "value": "display", "label": "Display — fills the width" }
            ],
            "default": "xl"
        },
        {
            "name": "heading_color",
            "type": "select",
            "label": "Heading colour",
            "tab": "Style",
            "options": [
                { "value": "inherit", "label": "Match the section text" },
                { "value": "accent", "label": "Accent" },
                { "value": "accent-2", "label": "Second accent" }
            ],
            "default": "inherit"
        },
        { "name": "reverse", "type": "checkbox", "label": "Split layout: image on the left", "tab": "Style", "default": false },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set heights = { 'auto': '', 'medium': 'min-h-[60vh]', 'large': 'min-h-[80vh]', 'full': 'min-h-screen' } %}
{% set overlays = {
    'none': '',
    'light': 'bg-black/25',
    'medium': 'bg-black/45',
    'heavy': 'bg-black/65',
    'gradient': 'bg-gradient-to-t from-black/90 via-black/45 to-black/10',
    'gradient-left': 'bg-gradient-to-r from-black/90 via-black/40 to-transparent'
} %}
{% set sizes = {
    'md': 'text-3xl sm:text-4xl lg:text-5xl',
    'lg': 'text-4xl sm:text-5xl lg:text-6xl',
    'xl': 'text-5xl sm:text-6xl lg:text-7xl',
    'display': 'text-6xl sm:text-8xl lg:text-9xl'
} %}
{% set corners = {
    'bottom-left': 'items-end justify-start text-left',
    'bottom-right': 'items-end justify-end text-right',
    'top-left': 'items-start justify-start text-left',
    'center-left': 'items-center justify-start text-left'
} %}
{% set heading_colors = { 'inherit': '', 'accent': 'text-accent', 'accent-2': 'text-accent-2' } %}

{% set height_class = heights[settings.height] ?? '' %}
{% set overlay_class = overlays[settings.overlay] ?? overlays['gradient'] %}
{% set size_class = sizes[settings.size] ?? sizes['xl'] %}
{% set corner_class = corners[settings.corner] ?? corners['bottom-left'] %}
{% set heading_class = heading_colors[settings.heading_color] ?? '' %}
{% set align_class = settings.align == 'left' ? 'text-left items-start' : 'text-center items-center' %}
{% set el = settings.heading.element ?? 'h1' %}

{% set layout = settings.layout ?? 'spotlight' %}
{% set has_video = settings.show_media and settings.video.path is not empty %}
{% set has_image = settings.show_media and settings.image.path is not empty %}
{% set on_media = layout in ['spotlight', 'poster', 'stack', 'card', 'corner'] and (has_video or has_image) %}
{% set ctas = [settings.primary_cta, settings.secondary_cta, settings.third_cta] | filter(c => c.url) %}
{% set show_ctas = settings.show_buttons and ctas|length %}

{# ---- Heading artwork ----
   Some releases have the title set as custom artwork rather than type, so the
   heading can be swapped for an image in every layout. The heading text is
   kept either way and used as the alt text.

   `b` is null when the brand collection is empty — that's safe to read from.
   Never default it with `?? {}`; an empty hash after ?? is a compile-time
   error in Canvas that blanks the whole block. #}
{% import 'components/brand' as brand %}
{% set b = (cms.collection('brand') ?? [])|first %}

{% if settings.heading_type == 'image' %}
  {% set heading_img = settings.heading_image.path ?? '' %}
{% elseif settings.heading_type == 'brand' %}
  {% set heading_img = brand.logo_url(b, settings.heading_variant)|trim %}
{% else %}
  {% set heading_img = '' %}
{% endif %}

{% set heading_w = settings.heading_image_width ?? 480 %}

{% import _self as ui %}

{#
  Renders the heading as text or as artwork.
  `wrap` classes apply to both; `text` classes (sizes, measure) only make sense
  on real type, so they're kept off the image.
#}
{% macro heading(el, text, img, width, wrap, text_klass) %}
  {% if img %}
    <img src="{{ img }}" alt="{{ text }}" style="width: {{ width }}px" class="h-auto max-w-full {{ wrap }}" />
  {% else %}
    <{{ el }} class="{{ wrap }} {{ text_klass }}">{{ text }}</{{ el }}>
  {% endif %}
{% endmacro %}

{% macro buttons(ctas, justify) %}
  <div class="mt-9 flex flex-wrap gap-3 {{ justify }}">
    {% for cta in ctas %}
      <a href="{{ cta.url }}" target="{{ cta.target }}" class="btn {{ loop.first ? 'btn-primary' : 'btn-outline' }}">{{ cta.text }}</a>
    {% endfor %}
  </div>
{% endmacro %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="relative isolate overflow-hidden {{ on_media ? 'text-white' : 'bg-bg text-ink' }}"
>
  {# ---- Background media. A video replaces the image when both are set,
         with the image reused as the poster frame so there's no black flash. ---- #}
  {% if on_media %}
    {% if has_video %}
      <video
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        {% if has_image %}poster="{{ settings.image.path }}"{% endif %}
        aria-hidden="true"
      >
        <source src="{{ settings.video.path }}" type="{{ settings.video.type ?? 'video/mp4' }}" />
      </video>
    {% else %}
      <img
        src="{{ settings.image.path }}"
        alt="{{ settings.image_alt }}"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        {% if settings.image_alt is empty %}aria-hidden="true"{% endif %}
      />
    {% endif %}

    {% if overlay_class %}
      <div class="absolute inset-0 -z-10 {{ overlay_class }}" aria-hidden="true"></div>
    {% endif %}
  {% endif %}

  {# ---------------- Split ---------------- #}
  {% if layout == 'split' %}
    <div class="wrap grid items-center gap-10 py-20 sm:py-28 lg:grid-cols-2 lg:gap-16 {{ height_class }}">
      <div class="flex flex-col {{ align_class }} {{ settings.reverse ? 'lg:order-2' : '' }}">
        {% if settings.show_eyebrow and settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
        {% if settings.show_heading %}
          {{ ui.heading(el, settings.heading.value, heading_img, heading_w, 'mt-4', 'text-balance ' ~ heading_class ~ ' ' ~ (settings.size == 'display' ? sizes['xl'] : size_class)) }}
        {% endif %}
        {% if settings.show_subheading and settings.subheading %}
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">{{ settings.subheading }}</p>
        {% endif %}
        {% if show_ctas %}{{ ui.buttons(ctas, settings.align == 'center' ? 'justify-center' : '') }}{% endif %}
      </div>

      {% if has_image %}
        <div class="{{ settings.reverse ? 'lg:order-1' : '' }}">
          <img src="{{ settings.image.path }}" alt="{{ settings.image_alt }}" class="aspect-4/5 w-full rounded-theme object-cover" />
        </div>
      {% endif %}
    </div>

  {# ---------------- Stack — centred lines of type over a button row ---------------- #}
  {% elseif layout == 'stack' %}
    <div class="wrap flex flex-col items-center justify-center py-24 text-center sm:py-32 {{ height_class }}">
      {% if settings.show_eyebrow and settings.eyebrow %}
        <p class="font-heading text-2xl tracking-tight text-accent uppercase sm:text-3xl">{{ settings.eyebrow }}</p>
      {% endif %}

      {% if settings.show_heading %}
        {{ ui.heading(el, settings.heading.value, heading_img, heading_w, 'mt-2', 'max-w-[16ch] text-balance ' ~ heading_class ~ ' ' ~ size_class) }}
      {% endif %}

      {% if settings.show_kicker and settings.kicker %}
        <p class="font-heading mt-2 text-xl tracking-wide uppercase sm:text-3xl">{{ settings.kicker }}</p>
      {% endif %}

      {% if settings.show_subheading and settings.subheading %}
        <p class="mt-6 max-w-2xl text-lg leading-relaxed {{ on_media ? 'opacity-80' : 'text-muted' }}">{{ settings.subheading }}</p>
      {% endif %}

      {% if show_ctas %}{{ ui.buttons(ctas, 'justify-center') }}{% endif %}
    </div>

  {# ---------------- Card — floating panel over the media ---------------- #}
  {% elseif layout == 'card' %}
    <div class="wrap flex py-10 sm:py-14 {{ corner_class }} {{ height_class }}">
      <div class="glass max-w-md p-7 sm:p-9">
        {% if settings.show_eyebrow and settings.eyebrow %}
          <span class="eyebrow">{{ settings.eyebrow }}</span>
        {% endif %}

        {% if settings.show_heading %}
          {{ ui.heading(el, settings.heading.value, heading_img, heading_w, 'mt-3', 'text-balance ' ~ heading_class ~ ' ' ~ (settings.size == 'display' ? sizes['lg'] : size_class)) }}
        {% endif %}

        {% if settings.show_subheading and settings.subheading %}
          <p class="mt-4 text-base leading-relaxed opacity-80">{{ settings.subheading }}</p>
        {% endif %}

        {% if show_ctas %}
          <div class="mt-7 flex flex-col gap-2">
            {% for cta in ctas %}
              <a href="{{ cta.url }}" target="{{ cta.target }}" class="btn {{ loop.first ? 'btn-primary' : 'btn-outline' }} w-full">{{ cta.text }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

  {# ---------------- Corner — text pinned to one corner of the media ---------------- #}
  {% elseif layout == 'corner' %}
    <div class="wrap flex py-12 sm:py-16 {{ corner_class }} {{ height_class }}">
      <div class="max-w-xl">
        {% if settings.show_eyebrow and settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}
        {% if settings.show_heading %}
          {{ ui.heading(el, settings.heading.value, heading_img, heading_w, 'mt-3', 'text-balance ' ~ heading_class ~ ' ' ~ size_class) }}
        {% endif %}
        {% if settings.show_kicker and settings.kicker %}
          <p class="mt-2 text-sm tracking-[0.18em] uppercase opacity-70">{{ settings.kicker }}</p>
        {% endif %}
        {% if settings.show_subheading and settings.subheading %}
          <p class="mt-4 text-base leading-relaxed opacity-80">{{ settings.subheading }}</p>
        {% endif %}
        {% if show_ctas %}
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
            {% for cta in ctas %}
              <a href="{{ cta.url }}" target="{{ cta.target }}" class="text-sm font-semibold tracking-wide uppercase underline underline-offset-4 transition hover:opacity-70">{{ cta.text }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

  {# ---------------- Poster ---------------- #}
  {% elseif layout == 'poster' %}
    <div class="wrap flex flex-col justify-end py-20 sm:py-28 {{ height_class }}">
      {% if settings.show_eyebrow and settings.eyebrow %}<span class="eyebrow">{{ settings.eyebrow }}</span>{% endif %}
      {% if settings.show_heading %}
        {{ ui.heading(el, settings.heading.value, heading_img, heading_w, 'mt-4', 'max-w-[14ch] text-balance ' ~ heading_class ~ ' ' ~ size_class) }}
      {% endif %}
      {% if settings.show_subheading and settings.subheading %}
        <p class="mt-6 max-w-xl text-lg leading-relaxed opacity-80">{{ settings.subheading }}</p>
      {% endif %}
      {% if show_ctas %}{{ ui.buttons(ctas, '') }}{% endif %}
    </div>

  {# ---------------- Spotlight / Minimal ---------------- #}
  {% else %}
    <div class="wrap flex flex-col justify-center py-24 sm:py-32 {{ align_class }} {{ height_class }}">
      {% if settings.show_eyebrow and settings.eyebrow %}
        <span class="eyebrow {{ on_media ? '' : 'text-accent' }}">{{ settings.eyebrow }}</span>
      {% endif %}
      {% if settings.show_heading %}
        {{ ui.heading(el, settings.heading.value, heading_img, heading_w, 'mt-4', 'max-w-[16ch] text-balance ' ~ heading_class ~ ' ' ~ size_class) }}
      {% endif %}
      {% if settings.show_subheading and settings.subheading %}
        <p class="mt-6 max-w-2xl text-lg leading-relaxed {{ on_media ? 'opacity-80' : 'text-muted' }}">{{ settings.subheading }}</p>
      {% endif %}
      {% if show_ctas %}{{ ui.buttons(ctas, settings.align == 'center' ? 'justify-center' : '') }}{% endif %}
    </div>
  {% endif %}

  {% if settings.show_scroll_hint %}
    <div class="pointer-events-none absolute inset-x-0 bottom-6 flex justify-center" aria-hidden="true">
      <svg class="h-6 w-6 animate-bounce opacity-60" viewBox="0 0 24 24" fill="none">
        <path d="M12 4v15m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  {% endif %}
</section>
{% endcanopy %}
