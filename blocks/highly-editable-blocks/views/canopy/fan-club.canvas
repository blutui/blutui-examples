{% canopy config %}
{
    "title": "Fan Club Registration",
    "name": "fan-club",
    "settings": [
        {
            "name": "layout",
            "type": "select",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "image", "label": "Image — photo one side, form the other" },
                { "value": "split", "label": "Split — perks one side, form the other" },
                { "value": "boxed", "label": "Boxed — form in a card" },
                { "value": "banner", "label": "Banner — a single strip across the page" }
            ],
            "default": "image"
        },
        {
            "name": "form_handle",
            "type": "select",
            "label": "Form",
            "tab": "Content",
            "options": [
                { "value": "fan_club", "label": "Fan Club — full registration" },
                { "value": "newsletter", "label": "Newsletter — email only" }
            ],
            "default": "fan_club"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "Fan club" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Join the fan club", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "body", "type": "richtext", "label": "Text beside the form", "tab": "Content", "default": "<p>Presale codes before anyone else, first refusal on tour tickets, and the odd thing we only send to the people on this list.</p>" },
        {
            "name": "perks",
            "type": "list",
            "label": "What members get — one per item",
            "tab": "Content",
            "default": [
                "48-hour presale window on every show",
                "Members-only vinyl and merch",
                "Demos, B-sides and rehearsal recordings",
                "Ballot entry for the small shows"
            ]
        },
        { "name": "submit_label", "type": "text", "label": "Button text", "tab": "Content", "default": "Join the fan club" },
        { "name": "hide_labels", "type": "checkbox", "label": "Hide field labels (use placeholders only)", "tab": "Content", "default": false },
        { "name": "two_columns", "type": "checkbox", "label": "Lay fields out in two columns", "tab": "Content", "default": true },
        { "name": "small_print", "type": "text", "label": "Small print below the form", "tab": "Content", "default": "One email a month at most. Unsubscribe any time." },
        { "name": "members_note", "type": "text", "label": "Line above the form", "tab": "Content", "default": "", "help_text": "Something like: 4,812 members and counting." },
        { "name": "image", "type": "file", "label": "Image", "accept": "image/*", "tab": "Content" },
        { "name": "show_perks", "type": "checkbox", "label": "Show the perks list", "tab": "Visibility", "default": true },
        { "name": "show_body", "type": "checkbox", "label": "Show the text", "tab": "Visibility", "default": true },
        { "name": "show_image", "type": "checkbox", "label": "Show the image", "tab": "Visibility", "default": true },
        {
            "name": "perk_style",
            "type": "select",
            "label": "Perks style",
            "tab": "Appearance",
            "options": [
                { "value": "ticks", "label": "Ticked list" },
                { "value": "numbers", "label": "Numbered list" },
                { "value": "rules", "label": "Ruled rows" },
                { "value": "pills", "label": "Pills" }
            ],
            "default": "ticks"
        },
        {
            "name": "image_position",
            "type": "radio",
            "label": "Image side",
            "tab": "Appearance",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "right", "label": "Right" }
            ],
            "default": "left"
        },
        {
            "name": "ratio",
            "type": "select",
            "label": "Image shape",
            "tab": "Appearance",
            "options": [
                { "value": "portrait", "label": "Portrait" },
                { "value": "square", "label": "Square" },
                { "value": "landscape", "label": "Landscape" },
                { "value": "fill", "label": "Fill the column" }
            ],
            "default": "portrait"
        },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "surface", "label": "Card colour" },
                { "value": "default", "label": "Page background" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "surface"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "fan-club" }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  Registration for the `fan_club` form created in the dashboard.

  The form itself comes from views/components/form.html, which has one branch
  per handle written literally — the {% form %} tag rejects a variable handle
  at compile time, and inside a Canopy block that blanks the whole section.
  Adding another form here means adding a branch there too.
#}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}
{% set ratios = { 'portrait': 'aspect-4/5', 'square': 'aspect-square', 'landscape': 'aspect-3/2', 'fill': 'h-full min-h-80' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['surface']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set ratio_class = ratios[settings.ratio] ?? ratios['portrait'] %}
{% set el = settings.heading.element ?? 'h2' %}
{% set layout = settings.layout ?? 'image' %}
{% set perks = settings.show_perks ? settings.perks|filter(p => p|trim is not empty) : [] %}
{% set has_image = settings.show_image and settings.image.path %}

{% set form_opts = {
    handle: settings.form_handle ?? 'fan_club',
    submit_label: settings.submit_label,
    hide_labels: settings.hide_labels,
    columns: settings.two_columns ? 2 : 1
} %}

{% import _self as ui %}

{% macro perk_list(perks, style) %}
  {% if perks|length %}
    {% if style == 'pills' %}
      <ul class="mt-6 flex list-none flex-wrap gap-2">
        {% for perk in perks %}<li class="pill text-xs">{{ perk }}</li>{% endfor %}
      </ul>
    {% elseif style == 'rules' %}
      <ul class="mt-6 list-none">
        {% for perk in perks %}
          <li class="border-b border-line py-3 first:border-t">{{ perk }}</li>
        {% endfor %}
      </ul>
    {% elseif style == 'numbers' %}
      <ol class="mt-6 list-none">
        {% for perk in perks %}
          <li class="flex items-baseline gap-3 py-1.5">
            <span class="text-sm font-semibold text-accent">{{ '%02d'|format(loop.index) }}</span>
            <span class="opacity-80">{{ perk }}</span>
          </li>
        {% endfor %}
      </ol>
    {% else %}
      <ul class="mt-6 list-none">
        {% for perk in perks %}
          <li class="flex items-baseline gap-3 py-1.5">
            <span class="text-accent" aria-hidden="true">&check;</span>
            <span class="opacity-80">{{ perk }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% endif %}
{% endmacro %}

{% macro intro(settings, el) %}
  {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
  <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
  {% if settings.show_body and settings.body %}
    <div class="rich mt-5 text-lg">{{ settings.body|raw }}</div>
  {% endif %}
{% endmacro %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    {# ---------------- Banner — one strip ---------------- #}
    {% if layout == 'banner' %}
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-16">
        <div class="lg:w-2/5">
          {{ ui.intro(settings, el) }}
        </div>
        <div class="lg:flex-1">
          {% if settings.members_note %}<p class="mb-3 text-sm opacity-60">{{ settings.members_note }}</p>{% endif %}
          {{ include('components/form.html', form_opts) }}
          {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
        </div>
      </div>

    {# ---------------- Boxed — form in a card ---------------- #}
    {% elseif layout == 'boxed' %}
      <div class="mx-auto max-w-2xl">
        <div class="text-center">{{ ui.intro(settings, el) }}</div>
        {{ ui.perk_list(perks, settings.perk_style) }}
        <div class="card mt-10 p-7 sm:p-10">
          {% if settings.members_note %}<p class="mb-4 text-sm opacity-60">{{ settings.members_note }}</p>{% endif %}
          {{ include('components/form.html', form_opts) }}
          {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
        </div>
      </div>

    {# ---------------- Image — photo beside the form ---------------- #}
    {% elseif layout == 'image' and has_image %}
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <img
          src="{{ settings.image.path }}"
          alt=""
          loading="lazy"
          class="{{ ratio_class }} w-full rounded-theme object-cover {{ settings.image_position == 'right' ? 'lg:order-2' : '' }}"
        />
        <div>
          {{ ui.intro(settings, el) }}
          {{ ui.perk_list(perks, settings.perk_style) }}
          <div class="mt-8">
            {% if settings.members_note %}<p class="mb-3 text-sm opacity-60">{{ settings.members_note }}</p>{% endif %}
            {{ include('components/form.html', form_opts) }}
            {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
          </div>
        </div>
      </div>

    {# ---------------- Split — perks beside the form ---------------- #}
    {% else %}
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          {{ ui.intro(settings, el) }}
          {{ ui.perk_list(perks, settings.perk_style) }}
        </div>
        <div>
          {% if settings.members_note %}<p class="mb-3 text-sm opacity-60">{{ settings.members_note }}</p>{% endif %}
          {{ include('components/form.html', form_opts) }}
          {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% endcanopy %}

