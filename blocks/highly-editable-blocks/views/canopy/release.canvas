{% canopy config %}
{
    "title": "Music Release",
    "name": "release",
    "settings": [
        {
            "name": "layout",
            "type": "radio",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "featured", "label": "Featured — artwork beside the details" },
                { "value": "stacked", "label": "Stacked — artwork above, centred details" },
                { "value": "embed", "label": "Embed — streaming player" }
            ],
            "default": "featured"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "Out now" },
        { "name": "heading", "type": "heading", "label": "Release title", "tab": "Content", "default": { "value": "Midnight Frequencies", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "meta", "type": "text", "label": "Format / date line", "tab": "Content", "default": "Album · 10 tracks · Released 14 March" },
        { "name": "description", "type": "richtext", "label": "Description", "tab": "Content", "default": "<p>Recorded over one long winter in a converted chapel, this record is the closest thing to hearing us in a room together.</p>" },
        { "name": "artwork", "type": "file", "label": "Artwork", "accept": "image/*", "tab": "Content" },
        { "name": "tracklist", "type": "list", "label": "Tracklist (one track per item)", "tab": "Content", "default": [] },
        { "name": "show_tracklist", "type": "checkbox", "label": "Show tracklist", "tab": "Content", "default": false },
        { "name": "embed_code", "type": "textarea", "label": "Embed code — paste the iframe from Spotify / Apple / Bandcamp / SoundCloud", "tab": "Content", "default": "" },
        { "name": "spotify", "type": "url", "label": "Spotify", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "Spotify", "target": "_blank" } },
        { "name": "apple", "type": "url", "label": "Apple Music", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "Apple Music", "target": "_blank" } },
        { "name": "youtube", "type": "url", "label": "YouTube Music", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "YouTube", "target": "_blank" } },
        { "name": "bandcamp", "type": "url", "label": "Bandcamp", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "Bandcamp", "target": "_blank" } },
        { "name": "soundcloud", "type": "url", "label": "SoundCloud", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "SoundCloud", "target": "_blank" } },
        { "name": "tidal", "type": "url", "label": "Tidal", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "Tidal", "target": "_blank" } },
        { "name": "deezer", "type": "url", "label": "Deezer", "tab": "Links", "group": "Streaming links", "default": { "url": "", "text": "Deezer", "target": "_blank" } },
        { "name": "buy", "type": "url", "label": "Buy / merch link", "tab": "Links", "group": "Other", "default": { "url": "", "text": "Buy vinyl", "target": "_blank" } },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "default"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        { "name": "reverse", "type": "checkbox", "label": "Featured layout: artwork on the right", "tab": "Style", "default": false },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "listen" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['default']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set el = settings.heading.element ?? 'h2' %}
{% set links = [settings.spotify, settings.apple, settings.youtube, settings.bandcamp, settings.soundcloud, settings.tidal, settings.deezer] | filter(l => l.url) %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    {# ---------------- Embed ---------------- #}
    {% if settings.layout == 'embed' %}
      <div class="mx-auto max-w-3xl text-center">
        {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
        <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
        {% if settings.meta %}<p class="mt-3 text-sm opacity-60">{{ settings.meta }}</p>{% endif %}
        {% if settings.description %}<div class="rich mt-6 text-left">{{ settings.description|raw }}</div>{% endif %}
      </div>

      {% if settings.embed_code %}
        <div class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-theme [&_iframe]:w-full [&_iframe]:rounded-theme">
          {{ settings.embed_code|raw }}
        </div>
      {% endif %}

      {% if links|length %}
        <div class="mt-8 flex flex-wrap justify-center gap-2">
          {% for link in links %}
            <a href="{{ link.url }}" target="{{ link.target }}" rel="noopener" class="pill">{{ link.text }}</a>
          {% endfor %}
        </div>
      {% endif %}

    {# ---------------- Stacked ---------------- #}
    {% elseif settings.layout == 'stacked' %}
      <div class="mx-auto max-w-2xl text-center">
        {% if settings.artwork.path %}
          <img
            src="{{ settings.artwork.path }}"
            alt="{{ settings.heading.value }} artwork"
            class="mx-auto aspect-square w-full max-w-md rounded-theme object-cover shadow-2xl shadow-black/40"
          />
        {% endif %}
        {% if settings.eyebrow %}<span class="eyebrow mt-10 text-accent">{{ settings.eyebrow }}</span>{% endif %}
        <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
        {% if settings.meta %}<p class="mt-3 text-sm opacity-60">{{ settings.meta }}</p>{% endif %}
        {% if settings.description %}<div class="rich mt-6">{{ settings.description|raw }}</div>{% endif %}

        {% if links|length %}
          <div class="mt-8 flex flex-wrap justify-center gap-2">
            {% for link in links %}
              <a href="{{ link.url }}" target="{{ link.target }}" rel="noopener" class="pill">{{ link.text }}</a>
            {% endfor %}
          </div>
        {% endif %}
        {% if settings.buy.url %}
          <a href="{{ settings.buy.url }}" target="{{ settings.buy.target }}" rel="noopener" class="btn btn-primary mt-6">{{ settings.buy.text }}</a>
        {% endif %}

        {% if settings.show_tracklist and settings.tracklist|length %}
          <ol class="mx-auto mt-10 max-w-md list-none space-y-0 text-left">
            {% for track in settings.tracklist %}
              <li class="flex gap-4 border-b border-line py-3 text-sm">
                <span class="w-6 shrink-0 tabular-nums opacity-40">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</span>
                <span>{{ track }}</span>
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </div>

    {# ---------------- Featured ---------------- #}
    {% else %}
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        {% if settings.artwork.path %}
          <div class="{{ settings.reverse ? 'lg:order-2' : '' }}">
            <img
              src="{{ settings.artwork.path }}"
              alt="{{ settings.heading.value }} artwork"
              class="aspect-square w-full rounded-theme object-cover shadow-2xl shadow-black/40"
            />
          </div>
        {% endif %}

        <div class="{{ settings.reverse ? 'lg:order-1' : '' }}">
          {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
          <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          {% if settings.meta %}<p class="mt-3 text-sm opacity-60">{{ settings.meta }}</p>{% endif %}
          {% if settings.description %}<div class="rich mt-6">{{ settings.description|raw }}</div>{% endif %}

          {% if links|length %}
            <div class="mt-8 flex flex-wrap gap-2">
              {% for link in links %}
                <a href="{{ link.url }}" target="{{ link.target }}" rel="noopener" class="pill">{{ link.text }}</a>
              {% endfor %}
            </div>
          {% endif %}
          {% if settings.buy.url %}
            <a href="{{ settings.buy.url }}" target="{{ settings.buy.target }}" rel="noopener" class="btn btn-primary mt-6">{{ settings.buy.text }}</a>
          {% endif %}

          {% if settings.show_tracklist and settings.tracklist|length %}
            <ol class="mt-10 list-none">
              {% for track in settings.tracklist %}
                <li class="flex gap-4 border-b border-line py-3 text-sm">
                  <span class="w-6 shrink-0 tabular-nums opacity-40">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</span>
                  <span>{{ track }}</span>
                </li>
              {% endfor %}
            </ol>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% endcanopy %}

