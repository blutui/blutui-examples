{% canopy config %}
{
    "title": "Gallery (Collection)",
    "name": "gallery",
    "settings": [
        {
            "name": "layout",
            "type": "select",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "grid", "label": "Grid — even columns" },
                { "value": "masonry", "label": "Masonry — staggered columns" },
                { "value": "mosaic", "label": "Mosaic — first image larger" },
                { "value": "strip", "label": "Strip — swipeable row" },
                { "value": "stack", "label": "Stack — full width, one per row" }
            ],
            "default": "grid"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Gallery", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "intro", "type": "textarea", "label": "Intro", "tab": "Content", "default": "" },
        { "name": "show_header", "type": "checkbox", "label": "Show the heading", "tab": "Content", "default": true },
        { "name": "caption", "type": "text", "label": "Caption below the gallery", "tab": "Content", "default": "" },
        { "name": "empty_text", "type": "text", "label": "Text shown when there are no images", "tab": "Content", "default": "No photos yet — add some to the Gallery collection." },
        { "name": "footer_cta", "type": "url", "label": "Button below the gallery", "tab": "Content", "default": { "url": "", "text": "See more photos", "target": "_self" } },
        {
            "name": "source",
            "type": "radio",
            "label": "Where the images come from",
            "tab": "Images",
            "options": [
                { "value": "collection", "label": "A collection — managed in the dashboard" },
                { "value": "upload", "label": "Uploaded into this block" }
            ],
            "default": "collection"
        },
        {
            "name": "collection_handle",
            "type": "select",
            "label": "Collection",
            "tab": "Images",
            "group": "From a collection",
            "options": [
                { "value": "gallery", "label": "Gallery" }
            ],
            "default": "gallery"
        },
        {
            "name": "sort",
            "type": "select",
            "label": "Order",
            "tab": "Images",
            "group": "From a collection",
            "options": [
                { "value": "manual", "label": "Manual order field" },
                { "value": "newest", "label": "Newest first" },
                { "value": "oldest", "label": "Oldest first" }
            ],
            "default": "manual"
        },
        {
            "name": "filter_tag",
            "type": "select",
            "label": "Only show this tag",
            "tab": "Images",
            "group": "From a collection",
            "options": [
                { "value": "all", "label": "All tags" },
                { "value": "Live", "label": "Live" },
                { "value": "Studio", "label": "Studio" },
                { "value": "Backstage", "label": "Backstage" },
                { "value": "Press", "label": "Press" },
                { "value": "Fans", "label": "Fans" },
                { "value": "Other", "label": "Other" }
            ],
            "default": "all"
        },
        { "name": "featured_only", "type": "checkbox", "label": "Only show featured images", "tab": "Images", "group": "From a collection", "default": false },
        { "name": "limit", "type": "number", "label": "Maximum images (0 = no limit)", "tab": "Images", "group": "From a collection", "min": 0, "max": 100, "default": 0 },
        { "name": "alt_text", "type": "text", "label": "Fallback image description", "tab": "Images", "group": "Uploaded into this block", "default": "Live photography" },
        { "name": "image_1", "type": "file", "label": "Image 1", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_2", "type": "file", "label": "Image 2", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_3", "type": "file", "label": "Image 3", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_4", "type": "file", "label": "Image 4", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_5", "type": "file", "label": "Image 5", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_6", "type": "file", "label": "Image 6", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_7", "type": "file", "label": "Image 7", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        { "name": "image_8", "type": "file", "label": "Image 8", "accept": "image/*", "tab": "Images", "group": "Uploaded into this block" },
        {
            "name": "columns",
            "type": "select",
            "label": "Columns",
            "tab": "Appearance",
            "options": [
                { "value": "2", "label": "Two" },
                { "value": "3", "label": "Three" },
                { "value": "4", "label": "Four" },
                { "value": "5", "label": "Five" }
            ],
            "default": "3"
        },
        {
            "name": "gap",
            "type": "select",
            "label": "Gap between images",
            "tab": "Appearance",
            "options": [
                { "value": "none", "label": "None — flush" },
                { "value": "xs", "label": "Hairline" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" }
            ],
            "default": "sm"
        },
        {
            "name": "ratio",
            "type": "select",
            "label": "Image shape",
            "tab": "Appearance",
            "options": [
                { "value": "square", "label": "Square" },
                { "value": "portrait", "label": "Portrait" },
                { "value": "tall", "label": "Tall" },
                { "value": "landscape", "label": "Landscape" },
                { "value": "wide", "label": "Widescreen" },
                { "value": "natural", "label": "Original shape" }
            ],
            "default": "square"
        },
        {
            "name": "radius",
            "type": "select",
            "label": "Corners",
            "tab": "Appearance",
            "options": [
                { "value": "theme", "label": "Follow the site theme" },
                { "value": "none", "label": "Square corners" },
                { "value": "large", "label": "Extra rounded" },
                { "value": "circle", "label": "Circles — use with square images" }
            ],
            "default": "theme"
        },
        {
            "name": "treatment",
            "type": "select",
            "label": "Image treatment",
            "tab": "Appearance",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "grayscale", "label": "Black and white" },
                { "value": "sepia", "label": "Warm / faded" },
                { "value": "punch", "label": "High contrast" }
            ],
            "default": "none"
        },
        {
            "name": "hover",
            "type": "select",
            "label": "Hover effect",
            "tab": "Appearance",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "zoom", "label": "Zoom in" },
                { "value": "lift", "label": "Lift" },
                { "value": "fade", "label": "Fade" },
                { "value": "colour", "label": "Black and white, colour on hover" }
            ],
            "default": "zoom"
        },
        {
            "name": "caption_style",
            "type": "select",
            "label": "Captions",
            "tab": "Appearance",
            "options": [
                { "value": "none", "label": "Hidden" },
                { "value": "below", "label": "Below the image" },
                { "value": "overlay", "label": "Over the image" },
                { "value": "hover", "label": "Over the image, on hover" }
            ],
            "default": "none"
        },
        { "name": "show_credit", "type": "checkbox", "label": "Show the photo credit", "tab": "Appearance", "default": false },
        { "name": "show_tag", "type": "checkbox", "label": "Show the tag badge", "tab": "Appearance", "default": false },
        { "name": "clickable", "type": "checkbox", "label": "Open the full-size image when clicked", "tab": "Appearance", "default": false, "help_text": "An entry with its own link uses that instead." },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "default"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "width",
            "type": "select",
            "label": "Gallery width",
            "tab": "Style",
            "options": [
                { "value": "wrap", "label": "Page width" },
                { "value": "full", "label": "Edge to edge" }
            ],
            "default": "wrap"
        },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        {
            "name": "align",
            "type": "radio",
            "label": "Header alignment",
            "tab": "Style",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Centre" }
            ],
            "default": "left"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "" }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  Images come from the `gallery` Collection (any number of them) or from the
  eight upload slots kept for blocks built before the collection existed.

  Both sources are normalised into one row shape — src, full, alt, caption,
  credit, tag, link — so the five layouts below only deal with one structure.
  A collection source with nothing in it falls back to the uploads, so an
  existing block keeps rendering after the collection is switched on.

  Guard the lookup with `?? []` — an unknown handle returns null, and piping
  null into |filter throws, which Canopy swallows into a blank section.
#}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}
{% set cols = {
    '2': 'sm:grid-cols-2',
    '3': 'sm:grid-cols-2 lg:grid-cols-3',
    '4': 'sm:grid-cols-2 lg:grid-cols-4',
    '5': 'sm:grid-cols-3 lg:grid-cols-5'
} %}
{# Masonry is CSS columns, so the vertical rhythm has to come from a margin on
   each figure — column-gap only spaces the columns themselves. #}
{% set masonry_cols = {
    '2': 'columns-1 sm:columns-2',
    '3': 'columns-1 sm:columns-2 lg:columns-3',
    '4': 'columns-2 sm:columns-3 lg:columns-4',
    '5': 'columns-2 sm:columns-3 lg:columns-5'
} %}
{% set gaps = { 'none': 'gap-0', 'xs': 'gap-1', 'sm': 'gap-3', 'md': 'gap-6', 'lg': 'gap-10' } %}
{% set masonry_gaps = {
    'none': 'gap-0 [&>figure]:mb-0',
    'xs': 'gap-1 [&>figure]:mb-1',
    'sm': 'gap-3 [&>figure]:mb-3',
    'md': 'gap-6 [&>figure]:mb-6',
    'lg': 'gap-10 [&>figure]:mb-10'
} %}
{% set ratios = {
    'square': 'aspect-square',
    'portrait': 'aspect-4/5',
    'tall': 'aspect-2/3',
    'landscape': 'aspect-3/2',
    'wide': 'aspect-video',
    'natural': ''
} %}
{% set radii = { 'theme': 'rounded-theme', 'none': 'rounded-none', 'large': 'rounded-3xl', 'circle': 'rounded-full' } %}
{% set treatments = { 'none': '', 'grayscale': 'grayscale', 'sepia': 'sepia', 'punch': 'contrast-125 saturate-125' } %}
{% set hovers = {
    'none': '',
    'zoom': 'transition-transform duration-500 ease-out group-hover:scale-105',
    'fade': 'transition-opacity duration-300 group-hover:opacity-60',
    'colour': 'grayscale transition duration-500 group-hover:grayscale-0'
} %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['default']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set align_class = settings.align == 'center' ? 'text-center mx-auto max-w-2xl' : '' %}
{% set el = settings.heading.element ?? 'h2' %}
{% set layout = settings.layout ?? 'grid' %}

{% set cfg = {
    'ratio': ratios[settings.ratio] ?? ratios['square'],
    'radius': radii[settings.radius] ?? radii['theme'],
    'treatment': settings.hover == 'colour' ? '' : (treatments[settings.treatment] ?? ''),
    'hover': hovers[settings.hover] ?? '',
    'lift': settings.hover == 'lift' ? 'transition-transform duration-300 hover:-translate-y-1' : '',
    'caption_style': settings.caption_style ?? 'none',
    'show_credit': settings.show_credit,
    'show_tag': settings.show_tag,
    'clickable': settings.clickable
} %}

{# ---- Normalise both sources into: src, full, alt, caption, credit, tag, link ---- #}
{% set rows = [] %}

{% if settings.source == 'collection' %}
  {% set entries = cms.collection(settings.collection_handle ?? 'gallery') ?? [] %}
  {% set entries = entries|filter(e => e.image is not empty) %}

  {% if settings.filter_tag != 'all' %}
    {% set entries = entries|filter(e => e.tag == settings.filter_tag) %}
  {% endif %}
  {% if settings.featured_only %}
    {% set entries = entries|filter(e => e.featured == 'Yes') %}
  {% endif %}

  {% if settings.sort == 'newest' %}
    {% set entries = entries|sort((a, b) => (b.created_at|date('U')) <=> (a.created_at|date('U'))) %}
  {% elseif settings.sort == 'oldest' %}
    {% set entries = entries|sort((a, b) => (a.created_at|date('U')) <=> (b.created_at|date('U'))) %}
  {% else %}
    {% set entries = entries|sort((a, b) => (a.order ?? 0) <=> (b.order ?? 0)) %}
  {% endif %}

  {% if settings.limit > 0 %}
    {% set entries = entries|slice(0, settings.limit) %}
  {% endif %}

  {% for e in entries %}
    {% set rows = rows|merge([{
        'src': e.image | image_url({ width: 1200, format: 'webp' }),
        'full': e.image | image_url({ width: 2400, format: 'webp' }),
        'alt': e.alt_text ?: (e.caption ?: settings.alt_text),
        'caption': e.caption ?? '',
        'credit': e.credit ?? '',
        'tag': e.tag ?? '',
        'link': e.link ?? ''
    }]) %}
  {% endfor %}
{% endif %}

{# Uploads are both the second source and the fallback for an empty collection. #}
{% if rows|length == 0 %}
  {% set uploads = [
      settings.image_1, settings.image_2, settings.image_3, settings.image_4,
      settings.image_5, settings.image_6, settings.image_7, settings.image_8
  ] | filter(i => i.path is not empty) %}

  {% for image in uploads %}
    {% set rows = rows|merge([{
        'src': image.path,
        'full': image.path,
        'alt': settings.alt_text,
        'caption': '',
        'credit': '',
        'tag': '',
        'link': ''
    }]) %}
  {% endfor %}
{% endif %}

{% import _self as ui %}

{#
  One tile, used by every layout. Macros can't see the outer context, so the
  resolved classes are handed over in `cfg`; `ratio` is passed separately
  because the mosaic layout overrides it for the first image.
#}
{% macro tile(row, cfg, ratio) %}
  {% set href = row.link ?: (cfg.clickable ? row.full : '') %}
  <figure class="group m-0 {{ cfg.lift }}">
    {% if href %}<a href="{{ href }}" {% if row.link %}target="_blank" rel="noopener"{% endif %} class="block no-underline">{% endif %}

    <div class="relative overflow-hidden {{ cfg.radius }}">
      <img
        src="{{ row.src }}"
        alt="{{ row.alt }}"
        loading="lazy"
        class="w-full {{ ratio }} {{ ratio ? 'object-cover' : '' }} {{ cfg.treatment }} {{ cfg.hover }}"
      />

      {% if cfg.show_tag and row.tag %}
        <span class="absolute top-3 left-3 rounded-theme bg-black/55 px-2.5 py-1 text-[0.7rem] font-semibold tracking-wide text-white uppercase backdrop-blur-sm">{{ row.tag }}</span>
      {% endif %}

      {% if cfg.caption_style in ['overlay', 'hover'] and (row.caption or (cfg.show_credit and row.credit)) %}
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent p-4 text-left text-white {{ cfg.caption_style == 'hover' ? 'opacity-0 transition-opacity duration-300 group-hover:opacity-100' : '' }}"
        >
          {% if row.caption %}<span class="block text-sm font-medium">{{ row.caption }}</span>{% endif %}
          {% if cfg.show_credit and row.credit %}<span class="block text-xs opacity-70">{{ row.credit }}</span>{% endif %}
        </figcaption>
      {% endif %}
    </div>

    {% if cfg.caption_style == 'below' and (row.caption or (cfg.show_credit and row.credit)) %}
      <figcaption class="mt-2 text-sm opacity-60">
        {{ row.caption }}
        {% if cfg.show_credit and row.credit %}<span class="opacity-70">· {{ row.credit }}</span>{% endif %}
      </figcaption>
    {% endif %}

    {% if href %}</a>{% endif %}
  </figure>
{% endmacro %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="{{ settings.width == 'full' ? 'px-0' : 'wrap' }} {{ pad_class }}">

    {% if settings.show_header %}
      <div class="{{ settings.width == 'full' ? 'wrap' : '' }} {{ align_class }} mb-10">
        {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
        <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
        {% if settings.intro %}<p class="mt-4 text-lg opacity-70">{{ settings.intro }}</p>{% endif %}
      </div>
    {% endif %}

    {% if rows|length %}

      {# ---------------- Masonry ---------------- #}
      {% if layout == 'masonry' %}
        <div class="{{ masonry_cols[settings.columns] ?? masonry_cols['3'] }} {{ masonry_gaps[settings.gap] ?? masonry_gaps['sm'] }}">
          {% for row in rows %}
            <div class="break-inside-avoid">{{ ui.tile(row, cfg, '') }}</div>
          {% endfor %}
        </div>

      {# ---------------- Mosaic — first image spans two columns ---------------- #}
      {% elseif layout == 'mosaic' %}
        <div class="grid {{ gaps[settings.gap] ?? gaps['sm'] }} sm:grid-cols-2 lg:grid-cols-3">
          {% for row in rows %}
            <div class="{{ loop.first ? 'sm:col-span-2 sm:row-span-2' : '' }}">
              {{ ui.tile(row, cfg, loop.first ? 'aspect-square' : cfg.ratio) }}
            </div>
          {% endfor %}
        </div>

      {# ---------------- Strip — horizontal scroll ---------------- #}
      {% elseif layout == 'strip' %}
        <div class="scroll-strip {{ settings.width == 'full' ? 'px-6' : '' }}">
          {% for row in rows %}
            <div>{{ ui.tile(row, cfg, cfg.ratio) }}</div>
          {% endfor %}
        </div>

      {# ---------------- Stack — one per row, full width ---------------- #}
      {% elseif layout == 'stack' %}
        <div class="grid {{ gaps[settings.gap] ?? gaps['sm'] }}">
          {% for row in rows %}
            {{ ui.tile(row, cfg, settings.ratio == 'natural' ? '' : 'aspect-video') }}
          {% endfor %}
        </div>

      {# ---------------- Grid ---------------- #}
      {% else %}
        <div class="grid {{ gaps[settings.gap] ?? gaps['sm'] }} {{ cols[settings.columns] ?? cols['3'] }}">
          {% for row in rows %}
            {{ ui.tile(row, cfg, cfg.ratio) }}
          {% endfor %}
        </div>
      {% endif %}

      {% if settings.caption %}
        <p class="{{ settings.width == 'full' ? 'wrap' : '' }} mt-6 text-sm opacity-50">{{ settings.caption }}</p>
      {% endif %}

      {% if settings.footer_cta.url %}
        <div class="{{ settings.width == 'full' ? 'wrap' : '' }} mt-10 {{ settings.align == 'center' ? 'text-center' : '' }}">
          <a href="{{ settings.footer_cta.url }}" target="{{ settings.footer_cta.target }}" class="btn btn-outline">{{ settings.footer_cta.text }}</a>
        </div>
      {% endif %}

    {% else %}
      <p class="{{ settings.width == 'full' ? 'wrap' : '' }} text-lg opacity-60">{{ settings.empty_text }}</p>
    {% endif %}
  </div>
</section>
{% endcanopy %}

