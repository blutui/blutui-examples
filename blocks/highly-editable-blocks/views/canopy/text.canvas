{% canopy config %}
{
    "title": "Text / About",
    "name": "text",
    "settings": [
        {
            "name": "layout",
            "type": "radio",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "single", "label": "Single column" },
                { "value": "two-column", "label": "Two columns — heading left, text right" },
                { "value": "with-image", "label": "With image" },
                { "value": "wide", "label": "Wide — full width text" }
            ],
            "default": "two-column"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "About" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "The story so far", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "show_heading", "type": "checkbox", "label": "Show the heading", "tab": "Content", "default": true },
        { "name": "body", "type": "richtext", "label": "Body", "tab": "Content", "default": "<p>Write the bio here. Where the project started, who's in the band, what the new record is about — anything a first-time listener would want to know.</p><p>Keep it to two or three short paragraphs. Press and promoters will lift straight from this, so put the strongest line first.</p>" },
        { "name": "image", "type": "file", "label": "Image", "accept": "image/*", "tab": "Content" },
        { "name": "image_alt", "type": "text", "label": "Image description", "tab": "Content", "default": "" },
        { "name": "cta", "type": "url", "label": "Button", "tab": "Content", "default": { "url": "", "text": "Read more", "target": "_self" } },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "default"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        {
            "name": "text_size",
            "type": "select",
            "label": "Text size",
            "tab": "Style",
            "options": [
                { "value": "base", "label": "Normal" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        { "name": "reverse", "type": "checkbox", "label": "Image layout: image on the right", "tab": "Style", "default": false },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "about" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}
{% set text_sizes = { 'base': 'text-base', 'lg': 'text-lg', 'xl': 'text-xl' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['default']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set size_class = text_sizes[settings.text_size] ?? text_sizes['lg'] %}
{% set el = settings.heading.element ?? 'h2' %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    {# ---------------- With image ---------------- #}
    {% if settings.layout == 'with-image' %}
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        {% if settings.image.path %}
          <div class="{{ settings.reverse ? 'lg:order-2' : '' }}">
            <img
              src="{{ settings.image.path }}"
              alt="{{ settings.image_alt }}"
              loading="lazy"
              class="aspect-4/5 w-full rounded-theme object-cover"
            />
          </div>
        {% endif %}
        <div class="{{ settings.reverse ? 'lg:order-1' : '' }}">
          {% if settings.show_heading %}
            {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
            <{{ el }} class="mt-3 mb-6 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          {% endif %}
          <div class="rich {{ size_class }}">{{ settings.body|raw }}</div>
          {% if settings.cta.url %}
            <a href="{{ settings.cta.url }}" target="{{ settings.cta.target }}" class="btn btn-outline mt-8">{{ settings.cta.text }}</a>
          {% endif %}
        </div>
      </div>

    {# ---------------- Two column ---------------- #}
    {% elseif settings.layout == 'two-column' %}
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
        {% if settings.show_heading %}
          <div class="lg:col-span-5">
            {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
            <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          </div>
        {% endif %}
        <div class="{{ settings.show_heading ? 'lg:col-span-7' : 'lg:col-span-12' }}">
          <div class="rich {{ size_class }}">{{ settings.body|raw }}</div>
          {% if settings.cta.url %}
            <a href="{{ settings.cta.url }}" target="{{ settings.cta.target }}" class="btn btn-outline mt-8">{{ settings.cta.text }}</a>
          {% endif %}
        </div>
      </div>

    {# ---------------- Single / Wide ---------------- #}
    {% else %}
      <div class="{{ settings.layout == 'single' ? 'mx-auto max-w-2xl' : '' }}">
        {% if settings.show_heading %}
          {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
          <{{ el }} class="mt-3 mb-6 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
        {% endif %}
        <div class="rich {{ size_class }} {{ settings.layout == 'wide' ? 'columns-1 md:columns-2 md:gap-12' : '' }}">{{ settings.body|raw }}</div>
        {% if settings.cta.url %}
          <a href="{{ settings.cta.url }}" target="{{ settings.cta.target }}" class="btn btn-outline mt-8">{{ settings.cta.text }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% endcanopy %}

