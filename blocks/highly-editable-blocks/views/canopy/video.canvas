{% canopy config %}
{
    "title": "Video",
    "name": "video",
    "settings": [
        {
            "name": "layout",
            "type": "radio",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "wide", "label": "Wide — full width player" },
                { "value": "split", "label": "Split — player beside text" },
                { "value": "bleed", "label": "Edge to edge — no gutters" }
            ],
            "default": "wide"
        },
        {
            "name": "source",
            "type": "select",
            "label": "Video source",
            "tab": "Content",
            "options": [
                { "value": "youtube", "label": "YouTube" },
                { "value": "vimeo", "label": "Vimeo" },
                { "value": "file", "label": "Uploaded file" }
            ],
            "default": "youtube"
        },
        { "name": "video_id", "type": "text", "label": "Video ID — the code at the end of the share URL, e.g. dQw4w9WgXcQ", "tab": "Content", "default": "" },
        { "name": "video_sources", "type": "media-sources", "label": "Uploaded video files", "tab": "Content" },
        { "name": "poster", "type": "file", "label": "Poster image (uploaded video only)", "accept": "image/*", "tab": "Content" },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "Watch" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Official video", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "description", "type": "textarea", "label": "Description", "tab": "Content", "default": "" },
        { "name": "cta", "type": "url", "label": "Button", "tab": "Content", "default": { "url": "", "text": "Watch on YouTube", "target": "_blank" } },
        { "name": "show_header", "type": "checkbox", "label": "Show the heading", "tab": "Content", "default": true },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "default"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        { "name": "reverse", "type": "checkbox", "label": "Split layout: player on the right", "tab": "Style", "default": false },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['default']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set el = settings.heading.element ?? 'h2' %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="{{ settings.layout == 'bleed' ? 'px-0' : 'wrap' }} {{ pad_class }}">
    <div class="{{ settings.layout == 'split' ? 'grid items-center gap-10 lg:grid-cols-2 lg:gap-16' : '' }}">

      {% if settings.show_header %}
        <div class="{{ settings.layout == 'split' ? (settings.reverse ? 'lg:order-1' : '') : 'mx-auto mb-10 max-w-2xl text-center' }} {{ settings.layout == 'bleed' ? 'wrap' : '' }}">
          {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
          <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          {% if settings.description %}<p class="mt-4 text-lg leading-relaxed opacity-70">{{ settings.description }}</p>{% endif %}
          {% if settings.cta.url %}
            <a href="{{ settings.cta.url }}" target="{{ settings.cta.target }}" rel="noopener" class="btn btn-outline mt-6">{{ settings.cta.text }}</a>
          {% endif %}
        </div>
      {% endif %}

      <div class="{{ settings.layout == 'split' and settings.reverse ? 'lg:order-2' : '' }}">
        <div class="aspect-video w-full overflow-hidden {{ settings.layout == 'bleed' ? '' : 'rounded-theme' }} bg-black">
          {% if settings.source == 'youtube' and settings.video_id %}
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ settings.video_id }}"
              title="{{ settings.heading.value }}"
              class="h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>

          {% elseif settings.source == 'vimeo' and settings.video_id %}
            <iframe
              src="https://player.vimeo.com/video/{{ settings.video_id }}"
              title="{{ settings.heading.value }}"
              class="h-full w-full"
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>

          {% elseif settings.source == 'file' and settings.video_sources|length %}
            <video
              controls
              playsinline
              class="h-full w-full object-cover"
              {% if settings.poster.path %}poster="{{ settings.poster.path }}"{% endif %}
            >
              {% for source in settings.video_sources %}
                <source src="{{ source.url }}" type="{{ source.type }}" />
              {% endfor %}
            </video>

          {% else %}
            <div class="flex h-full w-full items-center justify-center text-sm text-white/50">
              Add a video ID or upload a file to show the player.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endcanopy %}

