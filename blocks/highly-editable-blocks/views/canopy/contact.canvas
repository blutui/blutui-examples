{% canopy config %}
{
    "title": "Contact / Signup",
    "name": "contact",
    "settings": [
        {
            "name": "layout",
            "type": "radio",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "split", "label": "Split — text left, form right" },
                { "value": "centered", "label": "Centred — form below the heading" },
                { "value": "boxed", "label": "Boxed — form in a card" }
            ],
            "default": "split"
        },
        {
            "name": "form_handle",
            "type": "select",
            "label": "Form",
            "tab": "Content",
            "options": [
                { "value": "contact", "label": "Contact — bookings and enquiries" },
                { "value": "newsletter", "label": "Newsletter — mailing list signup" },
                { "value": "fan_club", "label": "Fan Club — full registration" }
            ],
            "default": "contact"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "Get in touch" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Bookings and enquiries", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "body", "type": "richtext", "label": "Text beside the form", "tab": "Content", "default": "<p>For booking, press or licensing, drop us a line and we'll come back to you within a few days.</p>" },
        { "name": "submit_label", "type": "text", "label": "Button text", "tab": "Content", "default": "Send message" },
        { "name": "hide_labels", "type": "checkbox", "label": "Hide field labels (use placeholders only)", "tab": "Content", "default": false },
        { "name": "two_columns", "type": "checkbox", "label": "Lay fields out in two columns", "tab": "Content", "default": false },
        { "name": "small_print", "type": "text", "label": "Small print below the form", "tab": "Content", "default": "We'll only use your details to reply. Unsubscribe any time." },
        { "name": "email", "type": "url", "label": "Direct email link", "tab": "Content", "default": { "url": "", "text": "", "target": "_self" } },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "surface"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "signup" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['surface']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set el = settings.heading.element ?? 'h2' %}

{% set form_opts = {
    handle: settings.form_handle ?? 'contact',
    submit_label: settings.submit_label,
    hide_labels: settings.hide_labels,
    columns: settings.two_columns ? 2 : 1
} %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    {% if settings.layout == 'split' %}
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
          <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          {% if settings.body %}<div class="rich mt-5 text-lg">{{ settings.body|raw }}</div>{% endif %}
          {% if settings.email.url %}
            <a href="{{ settings.email.url }}" class="btn btn-outline mt-6">{{ settings.email.text }}</a>
          {% endif %}
        </div>
        <div>
          {{ include('components/form.html', form_opts) }}
          {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
        </div>
      </div>

    {% elseif settings.layout == 'boxed' %}
      <div class="mx-auto max-w-2xl">
        <div class="text-center">
          {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
          <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
          {% if settings.body %}<div class="rich mt-5 text-lg">{{ settings.body|raw }}</div>{% endif %}
        </div>
        <div class="card mt-10 p-7 sm:p-10">
          {{ include('components/form.html', form_opts) }}
          {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
        </div>
      </div>

    {% else %}
      <div class="mx-auto max-w-2xl text-center">
        {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
        <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
        {% if settings.body %}<div class="rich mt-5 text-lg">{{ settings.body|raw }}</div>{% endif %}
        <div class="mt-10 text-left">
          {{ include('components/form.html', form_opts) }}
          {% if settings.small_print %}<p class="mt-4 text-xs opacity-50">{{ settings.small_print }}</p>{% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% endcanopy %}


