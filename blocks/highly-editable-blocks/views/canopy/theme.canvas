    'bodoni-moda':           { 'bunny': 'bodoni-moda:400,600,700,900',        'stack': "'Bodoni Moda', ui-serif, Georgia, serif", 'weight': '700' },
    'fraunces':              { 'bunny': 'fraunces:400,600,700,900',           'stack': "Fraunces, ui-serif, Georgia, serif", 'weight': '700' },
