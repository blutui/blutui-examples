    'archivo-black':         { 'bunny': 'archivo-black:400',                  'stack': "'Archivo Black', ui-sans-serif, system-ui, sans-serif", 'weight': '400' },
    'alfa-slab-one':         { 'bunny': 'alfa-slab-one:400',                  'stack': "'Alfa Slab One', ui-serif, Georgia, serif", 'weight': '400' },
    'rubik-mono-one':        { 'bunny': 'rubik-mono-one:400',                 'stack': "'Rubik Mono One', ui-sans-serif, system-ui, sans-serif", 'weight': '400' },
