                { "value": "ibm-plex-mono", "label": "Mono — IBM Plex Mono" },
                { "value": "jetbrains-mono", "label": "Mono — JetBrains Mono" }
            ],
            "default": "inter"
        },
        {
            "name": "heading_style",
            "type": "select",
            "label": "Heading style",
            "tab": "Typography",
            "options": [
                { "value": "normal", "label": "Normal" },
                { "value": "tight", "label": "Tight — negative tracking" },
                { "value": "tighter", "label": "Very tight — poster stacking" },
                { "value": "uppercase", "label": "Uppercase" },
                { "value": "uppercase-tight", "label": "Uppercase, tight" },
                { "value": "wide", "label": "Uppercase, widely spaced" }
            ],
            "default": "tight"
        },
        {
            "name": "heading_weight",
            "type": "select",
            "label": "Heading weight",
            "tab": "Typography",
            "options": [
                { "value": "auto", "label": "Automatic (match the font)" },
                { "value": "400", "label": "Regular" },
                { "value": "600", "label": "Semibold" },
                { "value": "700", "label": "Bold" },
                { "value": "800", "label": "Extrabold" },
                { "value": "900", "label": "Black" }
            ],
            "default": "auto"
        },
        {
            "name": "heading_leading",
            "type": "select",
            "label": "Heading line height",
            "tab": "Typography",
            "options": [
                { "value": "0.85", "label": "Crushed — stacked poster lines" },
                { "value": "0.95", "label": "Tight" },
                { "value": "1.05", "label": "Normal" },
                { "value": "1.2", "label": "Relaxed" }
            ],
            "default": "1.05"
        },
        {
            "name": "display_scale",
            "type": "select",
            "label": "Display size",
            "tab": "Typography",
            "options": [
                { "value": "0.85", "label": "Smaller" },
                { "value": "1", "label": "Default" },
                { "value": "1.15", "label": "Bigger" },
                { "value": "1.35", "label": "Huge" }
            ],
            "default": "1"
        },
        {
            "name": "nav_case",
            "type": "radio",
            "label": "Navigation and label case",
            "tab": "Typography",
            "options": [
                { "value": "none", "label": "As typed" },
                { "value": "uppercase", "label": "Uppercase" }
            ],
            "default": "none"
        },
        {
            "name": "radius",
            "type": "select",
            "label": "Corner rounding",
            "tab": "Style",
            "options": [
                { "value": "0px", "label": "Square" },
                { "value": "0.375rem", "label": "Slight" },
                { "value": "0.75rem", "label": "Rounded" },
                { "value": "1.25rem", "label": "Very rounded" },
                { "value": "2rem", "label": "Pill" }
            ],
            "default": "0.75rem"
        },
        {
            "name": "container",
            "type": "select",
            "label": "Content width",
            "tab": "Style",
            "options": [
                { "value": "64rem", "label": "Narrow" },
                { "value": "72rem", "label": "Default" },
                { "value": "80rem", "label": "Wide" },
                { "value": "96rem", "label": "Extra wide" },
                { "value": "100%", "label": "Full bleed" }
            ],
            "default": "72rem"
        },
        {
            "name": "button_style",
            "type": "select",
            "label": "Button style",
            "tab": "Style",
            "group": "Buttons",
            "options": [
                { "value": "solid", "label": "Solid — filled with the accent" },
                { "value": "outline", "label": "Outline — accent border only" },
                { "value": "brutal", "label": "Brutal — hard offset shadow" },
                { "value": "ghost", "label": "Ghost — text with an underline" }
            ],
            "default": "solid"
        },
        {
            "name": "button_shape",
            "type": "radio",
            "label": "Button shape",
            "tab": "Style",
            "group": "Buttons",
            "options": [
                { "value": "theme", "label": "Match corner rounding" },
                { "value": "pill", "label": "Pill" },
                { "value": "square", "label": "Square" }
            ],
            "default": "theme"
        },
        {
            "name": "button_case",
            "type": "radio",
            "label": "Button text case",
            "tab": "Style",
            "group": "Buttons",
            "options": [
                { "value": "none", "label": "As typed" },
                { "value": "uppercase", "label": "Uppercase" }
            ],
            "default": "none"
        },
        {
            "name": "texture",
            "type": "select",
            "label": "Page texture",
            "tab": "Style",
            "group": "Texture",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "grain", "label": "Film grain" },
                { "value": "scanlines", "label": "Scanlines" },
                { "value": "vignette", "label": "Vignette — darkened edges" }
            ],
            "default": "none"
        },
        { "name": "texture_strength", "type": "number", "label": "Texture strength (%)", "tab": "Style", "group": "Texture", "min": 1, "max": 100, "default": 25 }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  Site-wide theme. Renders a <style> block of CSS custom properties that every
  other block reads through Tailwind utilities (bg-bg, text-ink, bg-accent,
  font-heading, rounded-theme, ...). Defaults for all of these also live in
  :root in src/styles/global.css, so the site looks finished before an editor
  adds this block.

  Only `bunny` weights that the family actually publishes are requested —
  asking Bunny Fonts for a weight a family doesn't have returns nothing for
  that family, silently dropping the font.
#}
{% set fonts = {
    'figtree':               { 'bunny': 'figtree:400,500,700,800',            'stack': "Figtree, ui-sans-serif, system-ui, sans-serif", 'weight': '800' },
    'inter':                 { 'bunny': 'inter:400,500,600,700',              'stack': "Inter, ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'dm-sans':               { 'bunny': 'dm-sans:400,500,700',                'stack': "'DM Sans', ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'space-grotesk':         { 'bunny': 'space-grotesk:400,500,700',          'stack': "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'sora':                  { 'bunny': 'sora:400,500,700,800',               'stack': "Sora, ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'outfit':                { 'bunny': 'outfit:400,500,700,900',             'stack': "Outfit, ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'manrope':               { 'bunny': 'manrope:400,500,700,800',            'stack': "Manrope, ui-sans-serif, system-ui, sans-serif", 'weight': '800' },
    'work-sans':             { 'bunny': 'work-sans:400,500,600,700',          'stack': "'Work Sans', ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'chivo':                 { 'bunny': 'chivo:400,500,700,900',              'stack': "Chivo, ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'instrument-sans':       { 'bunny': 'instrument-sans:400,500,600,700',    'stack': "'Instrument Sans', ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
    'source-sans-3':         { 'bunny': 'source-sans-3:400,600,700,900',      'stack': "'Source Sans 3', ui-sans-serif, system-ui, sans-serif", 'weight': '700' },
