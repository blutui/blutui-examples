{% canopy config %}
{
    "title": "Site Theme",
    "name": "theme",
    "settings": [
        {
            "name": "palette",
            "type": "select",
            "label": "Colour preset",
            "tab": "Colours",
            "options": [
                { "value": "midnight", "label": "Midnight — dark neutral, electric violet" },
                { "value": "noir", "label": "Noir — pure black and white, red flash" },
                { "value": "acid", "label": "Acid — near-black, lime and magenta" },
                { "value": "sunset", "label": "Sunset — deep plum, coral and gold" },
                { "value": "poster", "label": "Poster — black, screen-print red and yellow" },
                { "value": "neon", "label": "Neon — black, hot pink and cyan" },
                { "value": "ultraviolet", "label": "Ultraviolet — deep purple, mint" },
                { "value": "ember", "label": "Ember — charcoal, burnt orange" },
                { "value": "sea", "label": "Sea — deep teal, aqua" },
                { "value": "slate", "label": "Slate — cool grey, soft blue" },
                { "value": "chrome", "label": "Chrome — gunmetal, silver" },
                { "value": "bone", "label": "Bone — warm off-white, ink" },
                { "value": "cream", "label": "Cream — light editorial, red" },
                { "value": "custom", "label": "Custom — use the pickers below" }
            ],
            "default": "midnight"
        },
        { "name": "custom_bg", "type": "color", "label": "Page background", "tab": "Colours", "group": "Custom palette", "default": "#0b0b12" },
        { "name": "custom_surface", "type": "color", "label": "Card / surface", "tab": "Colours", "group": "Custom palette", "default": "#15151f" },
