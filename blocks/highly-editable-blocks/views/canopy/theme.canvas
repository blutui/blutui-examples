            "type": "select",
            "label": "Body font",
            "tab": "Typography",
            "options": [
                { "value": "inter", "label": "Sans — Inter" },
                { "value": "figtree", "label": "Sans — Figtree" },
                { "value": "dm-sans", "label": "Sans — DM Sans" },
                { "value": "space-grotesk", "label": "Sans — Space Grotesk" },
                { "value": "sora", "label": "Sans — Sora" },
                { "value": "outfit", "label": "Sans — Outfit" },
                { "value": "manrope", "label": "Sans — Manrope" },
                { "value": "work-sans", "label": "Sans — Work Sans" },
                { "value": "chivo", "label": "Sans — Chivo" },
                { "value": "instrument-sans", "label": "Sans — Instrument Sans" },
                { "value": "source-sans-3", "label": "Sans — Source Sans 3" },
                { "value": "familjen-grotesk", "label": "Sans — Familjen Grotesk" },
                { "value": "barlow-condensed", "label": "Condensed — Barlow Condensed" },
                { "value": "lora", "label": "Serif — Lora" },
                { "value": "libre-baskerville", "label": "Serif — Libre Baskerville" },
