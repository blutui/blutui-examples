{% canopy config %}
{
    "title": "Tour Dates",
    "name": "tour",
    "settings": [
        {
            "name": "layout",
            "type": "radio",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "rows", "label": "Rows — one show per line" },
                { "value": "cards", "label": "Cards — grid of shows" },
                { "value": "compact", "label": "Compact — tight poster-style list" }
            ],
            "default": "rows"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "On the road" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Tour dates", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "intro", "type": "textarea", "label": "Intro", "tab": "Content", "default": "" },
        { "name": "cta_label", "type": "text", "label": "Ticket button label", "tab": "Content", "default": "Tickets" },
        { "name": "empty_text", "type": "text", "label": "Text shown when there are no dates", "tab": "Content", "default": "No shows announced right now — sign up below to hear first." },
        { "name": "footer_cta", "type": "url", "label": "Button below the list", "tab": "Content", "default": { "url": "", "text": "See all dates", "target": "_self" } },
        {
            "name": "source",
            "type": "radio",
            "label": "Where the shows come from",
            "tab": "Shows",
            "options": [
                { "value": "collection", "label": "A collection — managed in the dashboard" },
                { "value": "manual", "label": "Typed into this block" }
            ],
            "default": "manual"
        },
        {
            "name": "collection_handle",
            "type": "select",
            "label": "Collection",
            "tab": "Shows",
            "group": "From a collection",
            "options": [
                { "value": "tour_dates", "label": "Tour Dates" }
            ],
            "default": "tour_dates"
        },
        {
            "name": "sort",
            "type": "select",
            "label": "Order",
            "tab": "Shows",
            "group": "From a collection",
            "options": [
                { "value": "date", "label": "Soonest first" },
                { "value": "date-desc", "label": "Latest first" },
                { "value": "manual", "label": "Manual order field" }
            ],
            "default": "date"
        },
        { "name": "upcoming_only", "type": "checkbox", "label": "Hide shows that have already happened", "tab": "Shows", "group": "From a collection", "default": true },
        { "name": "featured_only", "type": "checkbox", "label": "Only show featured shows", "tab": "Shows", "group": "From a collection", "default": false },
        { "name": "limit", "type": "number", "label": "Maximum shows (0 = no limit)", "tab": "Shows", "group": "From a collection", "min": 0, "max": 100, "default": 0 },
        { "name": "date_format", "type": "text", "label": "Date format", "tab": "Shows", "group": "From a collection", "default": "D j M", "help_text": "Used when an entry has no date label." },
        {
            "name": "dates",
            "type": "list",
            "label": "Shows — one per item, separated by | : Date | City | Venue | Ticket link | Badge",
            "tab": "Shows",
            "group": "Typed into this block",
            "default": [
                "Fri 14 Aug | London, UK | O2 Academy Brixton | https://example.com/tickets | Low tickets",
                "Sat 15 Aug | Manchester, UK | Albert Hall | https://example.com/tickets |",
                "Mon 17 Aug | Glasgow, UK | Barrowland Ballroom | | Sold out",
                "Thu 20 Aug | Dublin, IE | Vicar Street | https://example.com/tickets |"
            ]
        },
        { "name": "show_venue", "type": "checkbox", "label": "Show the venue", "tab": "Visibility", "default": true },
        { "name": "show_badges", "type": "checkbox", "label": "Show the status badges", "tab": "Visibility", "default": true },
        { "name": "show_buttons", "type": "checkbox", "label": "Show the ticket buttons", "tab": "Visibility", "default": true },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "surface"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        {
            "name": "align",
            "type": "radio",
            "label": "Header alignment",
            "tab": "Style",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Centre" }
            ],
            "default": "left"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "tour" }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  Tour dates from either a Collection or a pipe-separated list typed into the
  block. Both sources are normalised into the same row shape up front, so the
  three layouts below only ever deal with one structure.

  Unlike the {% form %} tag, cms.collection() accepts a variable handle, so the
  collection really is editor-selectable.
#}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['surface']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set align_class = settings.align == 'center' ? 'text-center mx-auto max-w-2xl' : '' %}
{% set el = settings.heading.element ?? 'h2' %}

{# ---- Normalise both sources into: date, city, venue, link, badge ---- #}
{% set rows = [] %}

{% if settings.source == 'collection' %}
  {# A handle with no matching collection returns null, and piping null into
     |filter throws — which Canopy swallows, blanking the whole section. #}
  {% set entries = cms.collection(settings.collection_handle ?? 'tour_dates') ?? [] %}

  {% if settings.upcoming_only %}
    {% set entries = entries|filter(e => e.date is empty or (e.date|date('U')) >= ('now'|date('U'))) %}
  {% endif %}
  {% if settings.featured_only %}
    {% set entries = entries|filter(e => e.featured == 'Yes') %}
  {% endif %}

  {% if settings.sort == 'manual' %}
    {% set entries = entries|sort((a, b) => (a.order ?? 0) <=> (b.order ?? 0)) %}
  {% elseif settings.sort == 'date-desc' %}
    {% set entries = entries|sort((a, b) => (b.date|date('U')) <=> (a.date|date('U'))) %}
  {% else %}
    {% set entries = entries|sort((a, b) => (a.date|date('U')) <=> (b.date|date('U'))) %}
  {% endif %}

  {% if settings.limit > 0 %}
    {% set entries = entries|slice(0, settings.limit) %}
  {% endif %}

  {% for e in entries %}
    {# A sold-out or cancelled show shows its status instead of a buy link. #}
    {% set sold = e.status in ['Sold out', 'Cancelled'] %}
    {% set rows = rows|merge([{
        'date': e.date_label ?: (e.date ? e.date|date(settings.date_format ?? 'D j M') : ''),
        'city': e.city,
        'venue': e.venue ?? '',
        'link': sold ? '' : (e.ticket_url ?? ''),
        'badge': (e.status and e.status != 'On sale') ? e.status : ''
    }]) %}
  {% endfor %}

{% else %}
  {% for row in settings.dates|filter(d => d|trim is not empty) %}
    {% set p = row|split('|') %}
    {% set rows = rows|merge([{
        'date': (p[0] ?? '')|trim,
        'city': (p[1] ?? '')|trim,
        'venue': (p[2] ?? '')|trim,
        'link': (p[3] ?? '')|trim,
        'badge': (p[4] ?? '')|trim
    }]) %}
  {% endfor %}
{% endif %}

{% import _self as ui %}

{% macro badge(text) %}
  <span class="inline-block rounded-theme border border-line px-3 py-1.5 text-xs font-semibold tracking-wide uppercase opacity-60">{{ text }}</span>
{% endmacro %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    <div class="{{ align_class }}">
      {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
      <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
      {% if settings.intro %}<p class="mt-4 text-lg opacity-70">{{ settings.intro }}</p>{% endif %}
    </div>

    {% if rows|length %}
      {% if settings.layout == 'cards' %}
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {% for row in rows %}
            <div class="card flex flex-col gap-3 p-6">
              <span class="text-sm font-semibold tracking-wide text-accent uppercase">{{ row.date }}</span>
              <div>
                <p class="font-heading text-xl leading-tight">{{ row.city }}</p>
                {% if settings.show_venue and row.venue %}<p class="mt-1 text-sm opacity-60">{{ row.venue }}</p>{% endif %}
              </div>
              <div class="mt-auto pt-3">
                {% if settings.show_buttons and row.link %}
                  <a href="{{ row.link }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm w-full">{{ settings.cta_label }}</a>
                {% elseif settings.show_badges and row.badge %}
                  {{ ui.badge(row.badge) }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

      {% elseif settings.layout == 'compact' %}
        <ul class="mt-12 list-none">
          {% for row in rows %}
            <li class="border-b border-line first:border-t">
              <a
                {% if settings.show_buttons and row.link %}href="{{ row.link }}" target="_blank" rel="noopener"{% endif %}
                class="group flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4 no-underline {{ row.link ? 'transition hover:opacity-100 hover:pl-2' : '' }}"
              >
                <span class="w-28 shrink-0 text-sm font-semibold tracking-wide text-accent uppercase">{{ row.date }}</span>
                <span class="font-heading text-lg">{{ row.city }}</span>
                {% if settings.show_venue and row.venue %}<span class="text-sm opacity-50">{{ row.venue }}</span>{% endif %}
                <span class="ml-auto text-sm font-semibold">
                  {% if settings.show_badges and row.badge %}
                    <span class="opacity-50">{{ row.badge }}</span>
                  {% elseif settings.show_buttons and row.link %}
                    {{ settings.cta_label }} &rarr;
                  {% endif %}
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>

      {% else %}
        {# ---------------- Rows ---------------- #}
        <ul class="mt-12 list-none">
          {% for row in rows %}
            <li class="flex flex-col gap-4 border-b border-line py-6 first:border-t sm:flex-row sm:items-center sm:gap-8">
              <span class="shrink-0 text-sm font-semibold tracking-widest text-accent uppercase sm:w-32">{{ row.date }}</span>
              <div class="min-w-0 flex-1">
                <p class="font-heading text-xl leading-tight sm:text-2xl">{{ row.city }}</p>
                {% if settings.show_venue and row.venue %}<p class="mt-1 text-sm opacity-60">{{ row.venue }}</p>{% endif %}
              </div>
              <div class="shrink-0">
                {% if settings.show_buttons and row.link %}
                  <a href="{{ row.link }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">{{ settings.cta_label }}</a>
                {% elseif settings.show_badges and row.badge %}
                  {{ ui.badge(row.badge) }}
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if settings.footer_cta.url %}
        <div class="mt-10 {{ settings.align == 'center' ? 'text-center' : '' }}">
          <a href="{{ settings.footer_cta.url }}" target="{{ settings.footer_cta.target }}" class="btn btn-outline">{{ settings.footer_cta.text }}</a>
        </div>
      {% endif %}

    {% else %}
      <p class="mt-10 text-lg opacity-60">{{ settings.empty_text }}</p>
    {% endif %}
  </div>
</section>
{% endcanopy %}
