{% canopy config %}
{
    "title": "Past Gigs (Archive)",
    "name": "past-gigs",
    "settings": [
        {
            "name": "layout",
            "type": "select",
            "label": "Layout",
            "tab": "Content",
            "options": [
                { "value": "years", "label": "Grouped by year" },
                { "value": "rows", "label": "Rows — one show per line" },
                { "value": "cards", "label": "Cards — grid of shows" },
                { "value": "poster", "label": "Poster — dense tour-poster list" }
            ],
            "default": "years"
        },
        { "name": "eyebrow", "type": "text", "label": "Eyebrow", "tab": "Content", "default": "Archive" },
        { "name": "heading", "type": "heading", "label": "Heading", "tab": "Content", "default": { "value": "Every show we've played", "element": "h2" }, "elements": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
        { "name": "intro", "type": "textarea", "label": "Intro", "tab": "Content", "default": "" },
        { "name": "show_header", "type": "checkbox", "label": "Show the heading", "tab": "Content", "default": true },
        { "name": "link_label", "type": "text", "label": "Label for the show link", "tab": "Content", "default": "Photos" },
        { "name": "empty_text", "type": "text", "label": "Text shown when there's nothing to list", "tab": "Content", "default": "No past shows on record yet." },
        { "name": "footer_cta", "type": "url", "label": "Button below the archive", "tab": "Content", "default": { "url": "", "text": "", "target": "_self" } },
        {
            "name": "source",
            "type": "radio",
            "label": "Where the shows come from",
            "tab": "Shows",
            "options": [
                { "value": "collection", "label": "A collection — managed in the dashboard" },
                { "value": "manual", "label": "Typed into this block" }
            ],
            "default": "collection"
        },
        {
            "name": "collection_handle",
            "type": "select",
            "label": "Collection",
            "tab": "Shows",
            "group": "From a collection",
            "options": [
                { "value": "tour_dates", "label": "Tour Dates" }
            ],
            "default": "tour_dates"
        },
        {
            "name": "sort",
            "type": "select",
            "label": "Order",
            "tab": "Shows",
            "group": "From a collection",
            "options": [
                { "value": "newest", "label": "Most recent first" },
                { "value": "oldest", "label": "Oldest first" },
                { "value": "manual", "label": "Manual order field" }
            ],
            "default": "newest"
        },
        { "name": "featured_only", "type": "checkbox", "label": "Only show featured shows", "tab": "Shows", "group": "From a collection", "default": false },
        { "name": "limit", "type": "number", "label": "Maximum shows (0 = no limit)", "tab": "Shows", "group": "From a collection", "min": 0, "max": 500, "default": 0 },
        { "name": "date_format", "type": "text", "label": "Date format", "tab": "Shows", "group": "From a collection", "default": "j M Y", "help_text": "Used when an entry has no date label." },
        {
            "name": "gigs",
            "type": "list",
            "label": "Shows — one per item, separated by | : Year | Date | City | Venue | Link",
            "tab": "Shows",
            "group": "Typed into this block",
            "default": [
                "2024 | 12 Oct 2024 | London, UK | O2 Academy Brixton |",
                "2024 | 09 Oct 2024 | Manchester, UK | Albert Hall |",
                "2023 | 22 Jun 2023 | Glastonbury, UK | Park Stage |"
            ]
        },
        { "name": "show_date", "type": "checkbox", "label": "Show the date", "tab": "Visibility", "default": true },
        { "name": "show_venue", "type": "checkbox", "label": "Show the venue", "tab": "Visibility", "default": true },
        { "name": "show_links", "type": "checkbox", "label": "Show the show link", "tab": "Visibility", "default": false },
        { "name": "show_stats", "type": "checkbox", "label": "Show a shows / cities count", "tab": "Visibility", "default": true },
        {
            "name": "columns",
            "type": "select",
            "label": "Card and poster columns",
            "tab": "Appearance",
            "options": [
                { "value": "2", "label": "Two" },
                { "value": "3", "label": "Three" },
                { "value": "4", "label": "Four" }
            ],
            "default": "3"
        },
        {
            "name": "density",
            "type": "select",
            "label": "Row height",
            "tab": "Appearance",
            "options": [
                { "value": "airy", "label": "Airy" },
                { "value": "normal", "label": "Normal" },
                { "value": "tight", "label": "Tight" }
            ],
            "default": "normal"
        },
        {
            "name": "year_style",
            "type": "select",
            "label": "Year heading",
            "tab": "Appearance",
            "options": [
                { "value": "display", "label": "Large display type" },
                { "value": "rule", "label": "Small label with a rule" },
                { "value": "sticky", "label": "Small label, sticks while scrolling" }
            ],
            "default": "display"
        },
        {
            "name": "tone",
            "type": "select",
            "label": "Background",
            "tab": "Style",
            "options": [
                { "value": "default", "label": "Page background" },
                { "value": "surface", "label": "Card colour" },
                { "value": "accent", "label": "Accent" },
                { "value": "invert", "label": "Inverted" },
                { "value": "custom", "label": "Custom colours" }
            ],
            "default": "default"
        },
        { "name": "bg_color", "type": "color", "label": "Custom background", "tab": "Style", "group": "Custom colours", "default": "#15151f" },
        { "name": "text_color", "type": "color", "label": "Custom text", "tab": "Style", "group": "Custom colours", "default": "#f4f4f6" },
        {
            "name": "spacing",
            "type": "select",
            "label": "Vertical spacing",
            "tab": "Style",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "sm", "label": "Small" },
                { "value": "md", "label": "Medium" },
                { "value": "lg", "label": "Large" },
                { "value": "xl", "label": "Extra large" }
            ],
            "default": "lg"
        },
        {
            "name": "align",
            "type": "radio",
            "label": "Header alignment",
            "tab": "Style",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Centre" }
            ],
            "default": "left"
        },
        { "name": "anchor", "type": "text", "label": "Anchor ID (for menu links)", "tab": "Style", "default": "past-shows" }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  The other half of the Tour Dates block: everything that has already
  happened. It reads the same `tour_dates` Collection, keeps only entries
  whose date is in the past, and defaults to most-recent-first.

  Years are collected into their own list before rendering rather than
  tracked with a running variable inside the loop — grouping then becomes an
  ordinary nested loop with no scoping surprises.

  Guard the lookup with `?? []` — an unknown handle returns null, and piping
  null into |filter throws, which Canopy swallows into a blank section.
#}
{% set tones = {
    'default': 'bg-bg text-ink',
    'surface': 'bg-surface text-ink',
    'accent': 'bg-accent text-on-accent',
    'invert': 'bg-ink text-bg'
} %}
{% set pads = { 'none': 'py-0', 'sm': 'py-10 sm:py-12', 'md': 'py-16 sm:py-20', 'lg': 'py-24 sm:py-28', 'xl': 'py-32 sm:py-40' } %}
{% set cols = { '2': 'sm:grid-cols-2', '3': 'sm:grid-cols-2 lg:grid-cols-3', '4': 'sm:grid-cols-2 lg:grid-cols-4' } %}
{% set densities = { 'airy': 'py-6', 'normal': 'py-4', 'tight': 'py-2.5' } %}

{% set tone_class = settings.tone == 'custom' ? '' : (tones[settings.tone] ?? tones['default']) %}
{% set tone_style = settings.tone == 'custom' ? 'background-color:' ~ settings.bg_color ~ ';color:' ~ settings.text_color ~ ';' : '' %}
{% set pad_class = pads[settings.spacing] ?? pads['lg'] %}
{% set col_class = cols[settings.columns] ?? cols['3'] %}
{% set row_pad = densities[settings.density] ?? densities['normal'] %}
{% set align_class = settings.align == 'center' ? 'text-center mx-auto max-w-2xl' : '' %}
{% set el = settings.heading.element ?? 'h2' %}
{% set layout = settings.layout ?? 'years' %}

{# ---- Normalise both sources into: year, date, city, venue, link ---- #}
{% set rows = [] %}

{% if settings.source == 'collection' %}
  {% set entries = cms.collection(settings.collection_handle ?? 'tour_dates') ?? [] %}

  {# Past only. An entry with no date can't be placed in time, so it's dropped. #}
  {% set entries = entries|filter(e => e.date is not empty and (e.date|date('U')) < ('now'|date('U'))) %}

  {% if settings.featured_only %}
    {% set entries = entries|filter(e => e.featured == 'Yes') %}
  {% endif %}

  {% if settings.sort == 'oldest' %}
    {% set entries = entries|sort((a, b) => (a.date|date('U')) <=> (b.date|date('U'))) %}
  {% elseif settings.sort == 'manual' %}
    {% set entries = entries|sort((a, b) => (a.order ?? 0) <=> (b.order ?? 0)) %}
  {% else %}
    {% set entries = entries|sort((a, b) => (b.date|date('U')) <=> (a.date|date('U'))) %}
  {% endif %}

  {% if settings.limit > 0 %}
    {% set entries = entries|slice(0, settings.limit) %}
  {% endif %}

  {% for e in entries %}
    {% set rows = rows|merge([{
        'year': e.date|date('Y'),
        'date': e.date_label ?: e.date|date(settings.date_format ?? 'j M Y'),
        'city': e.city,
        'venue': e.venue ?? '',
        'link': e.ticket_url ?? ''
    }]) %}
  {% endfor %}

{% else %}
  {% for row in settings.gigs|filter(g => g|trim is not empty) %}
    {% set p = row|split('|') %}
    {% set rows = rows|merge([{
        'year': (p[0] ?? '')|trim,
        'date': (p[1] ?? '')|trim,
        'city': (p[2] ?? '')|trim,
        'venue': (p[3] ?? '')|trim,
        'link': (p[4] ?? '')|trim
    }]) %}
  {% endfor %}
{% endif %}

{# Distinct years, in the order the rows already sit in. #}
{% set years = [] %}
{% for row in rows %}
  {% if row.year and row.year not in years %}
    {% set years = years|merge([row.year]) %}
  {% endif %}
{% endfor %}

{% set cities = [] %}
{% for row in rows %}
  {% if row.city and row.city not in cities %}
    {% set cities = cities|merge([row.city]) %}
  {% endif %}
{% endfor %}

{% import _self as ui %}

{% macro row(row, settings, pad) %}
  <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line {{ pad }} first:border-t">
    {% if settings.show_date %}
      <span class="w-32 shrink-0 text-sm font-semibold tracking-wide text-accent uppercase">{{ row.date }}</span>
    {% endif %}
    <span class="font-heading text-lg">{{ row.city }}</span>
    {% if settings.show_venue and row.venue %}<span class="text-sm opacity-50">{{ row.venue }}</span>{% endif %}
    {% if settings.show_links and row.link %}
      <a href="{{ row.link }}" target="_blank" rel="noopener" class="ml-auto text-sm font-semibold no-underline hover:underline">{{ settings.link_label }} &rarr;</a>
    {% endif %}
  </li>
{% endmacro %}

{% macro year_heading(year, style) %}
  {% if style == 'rule' %}
    <div class="flex items-center gap-4">
      <span class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">{{ year }}</span>
      <span class="h-px flex-1 bg-line"></span>
    </div>
  {% elseif style == 'sticky' %}
    <div class="sticky top-0 z-10 bg-inherit py-2">
      <span class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">{{ year }}</span>
    </div>
  {% else %}
    <p class="font-heading text-4xl leading-none opacity-25 sm:text-6xl">{{ year }}</p>
  {% endif %}
{% endmacro %}

<section
  {% if settings.anchor %}id="{{ settings.anchor }}"{% endif %}
  class="{{ tone_class }}"
  {% if tone_style %}style="{{ tone_style }}"{% endif %}
>
  <div class="wrap {{ pad_class }}">

    {% if settings.show_header %}
      <div class="{{ align_class }}">
        {% if settings.eyebrow %}<span class="eyebrow text-accent">{{ settings.eyebrow }}</span>{% endif %}
        <{{ el }} class="mt-3 text-4xl text-balance sm:text-5xl">{{ settings.heading.value }}</{{ el }}>
        {% if settings.intro %}<p class="mt-4 text-lg opacity-70">{{ settings.intro }}</p>{% endif %}
      </div>
    {% endif %}

    {% if rows|length %}

      {% if settings.show_stats %}
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 {{ settings.align == 'center' ? 'justify-center' : '' }}">
          <div>
            <dt class="text-xs tracking-[0.14em] uppercase opacity-50">Shows</dt>
            <dd class="font-heading text-3xl">{{ rows|length }}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-[0.14em] uppercase opacity-50">Cities</dt>
            <dd class="font-heading text-3xl">{{ cities|length }}</dd>
          </div>
          {% if years|length %}
            <div>
              <dt class="text-xs tracking-[0.14em] uppercase opacity-50">Years</dt>
              <dd class="font-heading text-3xl">{{ years|length }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {# ---------------- Cards ---------------- #}
      {% if layout == 'cards' %}
        <div class="mt-12 grid gap-4 {{ col_class }}">
          {% for row in rows %}
            <div class="card flex flex-col gap-2 p-6">
              {% if settings.show_date %}
                <span class="text-sm font-semibold tracking-wide text-accent uppercase">{{ row.date }}</span>
              {% endif %}
              <p class="font-heading text-xl leading-tight">{{ row.city }}</p>
              {% if settings.show_venue and row.venue %}<p class="text-sm opacity-60">{{ row.venue }}</p>{% endif %}
              {% if settings.show_links and row.link %}
                <a href="{{ row.link }}" target="_blank" rel="noopener" class="mt-auto pt-3 text-sm font-semibold no-underline hover:underline">{{ settings.link_label }} &rarr;</a>
              {% endif %}
            </div>
          {% endfor %}
        </div>

      {# ---------------- Poster — dense columns of text ---------------- #}
      {% elseif layout == 'poster' %}
        <ul class="mt-12 grid list-none gap-x-10 {{ col_class }}">
          {% for row in rows %}
            <li class="flex items-baseline gap-3 border-b border-line py-2 text-sm">
              {% if settings.show_date %}<span class="shrink-0 font-semibold tracking-wide text-accent uppercase">{{ row.date }}</span>{% endif %}
              <span class="font-heading">{{ row.city }}</span>
              {% if settings.show_venue and row.venue %}<span class="truncate opacity-50">{{ row.venue }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>

      {# ---------------- Grouped by year ---------------- #}
      {% elseif layout == 'years' and years|length %}
        {% for year in years %}
          <div class="mt-14 first:mt-12">
            {{ ui.year_heading(year, settings.year_style) }}
            <ul class="mt-4 list-none">
              {% for row in rows|filter(r => r.year == year) %}
                {{ ui.row(row, settings, row_pad) }}
              {% endfor %}
            </ul>
          </div>
        {% endfor %}

      {# ---------------- Rows ---------------- #}
      {% else %}
        <ul class="mt-12 list-none">
          {% for row in rows %}
            {{ ui.row(row, settings, row_pad) }}
          {% endfor %}
        </ul>
      {% endif %}

      {% if settings.footer_cta.url %}
        <div class="mt-12 {{ settings.align == 'center' ? 'text-center' : '' }}">
          <a href="{{ settings.footer_cta.url }}" target="{{ settings.footer_cta.target }}" class="btn btn-outline">{{ settings.footer_cta.text }}</a>
        </div>
      {% endif %}

    {% else %}
      <p class="mt-10 text-lg opacity-60">{{ settings.empty_text }}</p>
    {% endif %}
  </div>
</section>
{% endcanopy %}

